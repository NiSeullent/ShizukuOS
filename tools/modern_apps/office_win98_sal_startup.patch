+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * Windows 98 routing for SAL calls that KERNEL32 on Windows 98 does not export.
+ * Added by the ShizukuOS LIBO_WIN98 port; the providers live in OFFSAL.DLL
+ * (ntwin32/office_sal) and fail with a truthful Win32 error where Windows 98
+ * cannot honour the request.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#if defined(LIBO_WIN98) && LIBO_WIN98
+extern "C" {
+BOOL WINAPI OfsSetProcessDEPPolicy(DWORD);
+BOOL WINAPI OfsSetDllDirectoryW(LPCWSTR);
+BOOL WINAPI OfsSetSearchPathMode(DWORD);
+DWORD WINAPI OfsGetProcessId(HANDLE);
+BOOL WINAPI OfsRegisterProcessHandle(HANDLE, DWORD);
+BOOL WINAPI OfsForgetProcessHandle(HANDLE);
+BOOL WINAPI OfsGetModuleHandleExW(DWORD, LPCWSTR, HMODULE*);
+BOOL WINAPI OfsGetFileSizeEx(HANDLE, LARGE_INTEGER*);
+BOOL WINAPI OfsSetFilePointerEx(HANDLE, LARGE_INTEGER, LARGE_INTEGER*, DWORD);
+BOOL WINAPI OfsReplaceFileW(LPCWSTR, LPCWSTR, LPCWSTR, DWORD, LPVOID, LPVOID);
+}
+#define SetProcessDEPPolicy OfsSetProcessDEPPolicy
+#define SetDllDirectoryW OfsSetDllDirectoryW
+#define SetSearchPathMode OfsSetSearchPathMode
+#define GetProcessId OfsGetProcessId
+#define GetModuleHandleExW OfsGetModuleHandleExW
+#define GetFileSizeEx OfsGetFileSizeEx
+#define SetFilePointerEx OfsSetFilePointerEx
+#define ReplaceFileW OfsReplaceFileW
+#endif
+
