diff --git a/b/src/win/shizuku-lciocp.h b/src/win/shizuku-lciocp.h
new file mode 100644
index 0000000..9a95ecd
--- /dev/null
+++ b/src/win/shizuku-lciocp.h
@@ -0,0 +1,54 @@
+/* ShizukuOS Win98 port of the libuv Windows backend (Legcord / Node 24.18.0).
+ * Win98 KERNEL32 has no I/O completion ports and Win98 WS2_32 completes
+ * overlapped socket I/O only through events; LCIOCP.DLL (ShizukuOS source
+ * ntwin32/legcord_iocp, GPL-2.0-only provider) supplies both with the NT
+ * argument/failure contracts. Enabled only with -DUV_SHIZUKU_LCIOCP.
+ */
+#ifndef UV_WIN_SHIZUKU_LCIOCP_H_
+#define UV_WIN_SHIZUKU_LCIOCP_H_
+
+#ifdef UV_SHIZUKU_LCIOCP
+__declspec(dllimport) HANDLE WINAPI ShizukuLc_CreateIoCompletionPort(HANDLE, HANDLE, ULONG_PTR, DWORD);
+__declspec(dllimport) BOOL WINAPI ShizukuLc_PostQueuedCompletionStatus(HANDLE, DWORD, ULONG_PTR, LPOVERLAPPED);
+__declspec(dllimport) BOOL WINAPI ShizukuLc_GetQueuedCompletionStatusEx(HANDLE, LPOVERLAPPED_ENTRY, ULONG,
+                                                                        PULONG, DWORD, BOOL);
+__declspec(dllimport) BOOL WINAPI ShizukuLc_CloseIoCompletionPort(HANDLE);
+__declspec(dllimport) int WSAAPI ShizukuLc_WSARecv(SOCKET, LPWSABUF, DWORD, LPDWORD, LPDWORD,
+    LPWSAOVERLAPPED, LPWSAOVERLAPPED_COMPLETION_ROUTINE);
+__declspec(dllimport) int WSAAPI ShizukuLc_WSASend(SOCKET, LPWSABUF, DWORD, LPDWORD, DWORD,
+    LPWSAOVERLAPPED, LPWSAOVERLAPPED_COMPLETION_ROUTINE);
+__declspec(dllimport) int WSAAPI ShizukuLc_WSARecvFrom(SOCKET, LPWSABUF, DWORD, LPDWORD, LPDWORD,
+    struct sockaddr*, LPINT, LPWSAOVERLAPPED, LPWSAOVERLAPPED_COMPLETION_ROUTINE);
+__declspec(dllimport) int WSAAPI ShizukuLc_WSASendTo(SOCKET, LPWSABUF, DWORD, LPDWORD, DWORD,
+    const struct sockaddr*, int, LPWSAOVERLAPPED, LPWSAOVERLAPPED_COMPLETION_ROUTINE);
+__declspec(dllimport) BOOL PASCAL ShizukuLc_ConnectEx(SOCKET, const struct sockaddr*, int, PVOID,
+    DWORD, LPDWORD, LPOVERLAPPED);
+__declspec(dllimport) int WSAAPI ShizukuLc_closesocket(SOCKET);
+
+/* Loop port lifetime (core.c, req-inl.h). */
+#define uv__iocp_create ShizukuLc_CreateIoCompletionPort
+#define uv__iocp_post ShizukuLc_PostQueuedCompletionStatus
+#define uv__iocp_get_ex ShizukuLc_GetQueuedCompletionStatusEx
+#define uv__iocp_close ShizukuLc_CloseIoCompletionPort
+/* Association and socket I/O call sites in tcp.c, udp.c, pipe.c, poll.c,
+ * fs-event.c. Non-socket association fails with ERROR_NOT_SUPPORTED. */
+#define CreateIoCompletionPort ShizukuLc_CreateIoCompletionPort
+#define PostQueuedCompletionStatus ShizukuLc_PostQueuedCompletionStatus
+#define WSARecv ShizukuLc_WSARecv
+#define WSASend ShizukuLc_WSASend
+#define WSARecvFrom ShizukuLc_WSARecvFrom
+#define WSASendTo ShizukuLc_WSASendTo
+#define closesocket ShizukuLc_closesocket
+/* ConnectEx is emulated with connect(); the socket context is already
+ * updated, and Win98 has no SO_UPDATE_CONNECT_CONTEXT. */
+#define uv__tcp_update_connect_context(s) 0
+#else
+#define uv__iocp_create CreateIoCompletionPort
+#define uv__iocp_post PostQueuedCompletionStatus
+#define uv__iocp_get_ex GetQueuedCompletionStatusEx
+#define uv__iocp_close CloseHandle
+#define uv__tcp_update_connect_context(s)                                     \
+  setsockopt((s), SOL_SOCKET, SO_UPDATE_CONNECT_CONTEXT, NULL, 0)
+#endif
+
+#endif /* UV_WIN_SHIZUKU_LCIOCP_H_ */
