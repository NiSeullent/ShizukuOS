diff --git a/src/win/winapi.c b/src/win/winapi.c
--- a/src/win/winapi.c
+++ b/src/win/winapi.c
@@ -51,6 +51,47 @@
 /* api-ms-win-core-file-l2-1-4.dll function pointer */
 sGetFileInformationByName pGetFileInformationByName;
 
+#ifdef UV_SHIZUKU_LCIOCP
+/* ShizukuOS / Windows 98: there is no ntdll.dll and GetModuleHandleW is a
+ * stub. The mandatory NT entry points are provided by LCIOCP.DLL (ShizukuOS
+ * ntwin32/legcord_iocp lc_ntdll) under ShizukuLc_* names and resolved by ANSI
+ * lookups. Required set is identical to upstream (fatal when absent);
+ * RtlGetVersion stays optional. The optional powrprof/bcryptprimitives/
+ * user32/ws2_32/api-ms entry points are not resolved and stay NULL, which
+ * their callers already handle. */
+static void uv__lciocp_bind(HMODULE module, const char* name, void* slot,
+                            int required) {
+  FARPROC proc = GetProcAddress(module, name);
+  if (proc == NULL && required) {
+    uv_fatal_error(GetLastError(), "GetProcAddress");
+  }
+  memcpy(slot, &proc, sizeof(proc));
+}
+
+void uv__winapi_init(void) {
+  HMODULE lciocp_module = LoadLibraryA("LCIOCP.DLL");
+  if (lciocp_module == NULL) {
+    uv_fatal_error(GetLastError(), "LoadLibraryA");
+  }
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_RtlGetVersion", &pRtlGetVersion, 0);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_RtlNtStatusToDosError",
+                  &pRtlNtStatusToDosError, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtDeviceIoControlFile",
+                  &pNtDeviceIoControlFile, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtQueryInformationFile",
+                  &pNtQueryInformationFile, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtSetInformationFile",
+                  &pNtSetInformationFile, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtQueryVolumeInformationFile",
+                  &pNtQueryVolumeInformationFile, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtQueryDirectoryFile",
+                  &pNtQueryDirectoryFile, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtQuerySystemInformation",
+                  &pNtQuerySystemInformation, 1);
+  uv__lciocp_bind(lciocp_module, "ShizukuLc_NtQueryInformationProcess",
+                  &pNtQueryInformationProcess, 1);
+}
+#else
 void uv__winapi_init(void) {
   HMODULE ntdll_module;
   HMODULE powrprof_module;
@@ -171,3 +212,4 @@
     pGetFileInformationByName = u.pGetFileInformationByName;
   }
 }
+#endif /* UV_SHIZUKU_LCIOCP */
