+#include "navigation_trace.h"
+#ifdef IEWK_NAV_DIAGNOSTIC
+/* Offline private protocol telemetry. Observe callback results without changing
+ * URLMon ownership, bind eligibility, pending consumption or engine failures. */
+static LONG diagnostic_starts;
+static void protocol_trace(DWORD event, const char *field, DWORD value) {
+  char key[96];
+  wsprintfA(key, "Handoff.%lu.%s", event, field);
+  iewk_navigation_trace(key, value);
+}
+static void protocol_text(DWORD event, const char *field, const char *value,
+                          DWORD bytes) {
+  char key[96];
+  wsprintfA(key, "Handoff.%lu.%s", event, field);
+  HANDLE file = CreateFileA("C:\\ZUKUQA\\IENAV.LOG", GENERIC_WRITE,
+                            FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+  if (file == INVALID_HANDLE_VALUE)
+    return;
+  DWORD high = 0, size = GetFileSize(file, &high), written = 0;
+  DWORD key_bytes = static_cast<DWORD>(lstrlenA(key));
+  if (!high && size != INVALID_FILE_SIZE && bytes <= IEWK_URL_LIMIT &&
+      size <= 65536UL - bytes - key_bytes - 3 &&
+      SetFilePointer(file, 0, NULL, FILE_END) != INVALID_SET_FILE_POINTER) {
+    if (WriteFile(file, key, key_bytes, &written, NULL) && written == key_bytes &&
+        WriteFile(file, "=", 1, &written, NULL) && written == 1 &&
+        WriteFile(file, value, bytes, &written, NULL) && written == bytes)
+      WriteFile(file, "\r\n", 2, &written, NULL);
+    FlushFileBuffers(file);
+  }
+  CloseHandle(file);
+}
+static void protocol_url(DWORD event, LPCWSTR url) {
+  char ascii[IEWK_URL_LIMIT + 1];
+  DWORD length = 0;
+  bool valid = url != NULL;
+  while (valid && length < IEWK_URL_LIMIT && url[length]) {
+    if (url[length] < 33 || url[length] > 126)
+      valid = false;
+    else {
+      ascii[length] = static_cast<char>(url[length]);
+      ++length;
+    }
+  }
+  valid = valid && length && !url[length];
+  protocol_trace(event, "url.valid", valid);
+  if (!valid)
+    return;
+  ascii[length] = 0;
+  protocol_text(event, "url", ascii, length);
+  const char *segment = std::strrchr(ascii, '/');
+  DWORD count = segment ? static_cast<DWORD>(std::strlen(++segment)) : 0;
+  bool nonce_valid = count && count <= 80 &&
+      std::strspn(segment, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_") == count;
+  protocol_trace(event, "nonce.valid", nonce_valid);
+  if (nonce_valid)
+    protocol_text(event, "nonce", segment, count);
+}
+#endif
 
