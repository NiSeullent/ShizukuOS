     }
--- a/Source/WTF/wtf/StackTrace.cpp
+++ b/Source/WTF/wtf/StackTrace.cpp
@@ -45,7 +45,16 @@
 #if HAVE(BACKTRACE)
     *size = backtrace(stack, *size);
 #elif OS(WINDOWS)
+#if defined(IEWEBKIT_WIN9X) && IEWEBKIT_WIN9X
+    // Optional diagnostic capability: Win9x has no native RTL stack capture.
+    // Preserve the existing unsupported-platform result when it is absent.
+    using CaptureBacktrace = USHORT (WINAPI*)(ULONG, ULONG, PVOID*, PULONG);
+    HMODULE kernel = GetModuleHandleA("kernel32.dll");
+    auto capture = kernel ? std::bit_cast<CaptureBacktrace>(GetProcAddress(kernel, "RtlCaptureStackBackTrace")) : nullptr;
+    *size = capture && *size > 0 ? capture(0, *size, stack, nullptr) : 0;
+#else
     *size = RtlCaptureStackBackTrace(0, *size, stack, nullptr);
+#endif
 #else
     UNUSED_PARAM(stack);
     *size = 0;
