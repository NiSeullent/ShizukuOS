diff --git a/shizukudos/win64/kernel32/k32_e1_gap.c b/shizukudos/win64/kernel32/k32_e1_gap.c
new file mode 100644
index 0000000..26b3f89
--- /dev/null
+++ b/shizukudos/win64/kernel32/k32_e1_gap.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * kernel32.dll: the load-time imports of Electron / Node.js (libuv) that Chromium does not use. electron.exe and the VS Code
+ * executables import these by name at load time, so each one has to exist for the image to map at all; what each does here:
+ *
+ *  - CancelSynchronousIo: Kernel64 has no way to cancel a synchronous request of another thread, so it reports what Windows
+ *    reports when there is nothing to cancel, ERROR_NOT_FOUND (a thread blocked in a synchronous read stays blocked).
+ *  - CreateSymbolicLinkW: no file system of this system stores symbolic links (FAT32 D:, ShizukuFS E:): ERROR_NOT_SUPPORTED.
+ *  - ReOpenFile: a second handle to the file behind `orig` with the requested access, sharing and flags, opened by the path
+ *    GetFinalPathNameByHandleW reports for it.
+ *  - GetProcessIoCounters: the kernel does not count read/write operations or bytes per process, and zeros would be made-up
+ *    data: ERROR_NOT_SUPPORTED.
+ *  - GetCurrentPackageFullName, GetPackageFamilyName: there are no packaged (AppX) applications, so every process has no
+ *    package identity: APPMODEL_ERROR_NO_PACKAGE, returned as the result as the API defines.
+ *  - NeedCurrentDirectoryForExePathW: TRUE for a name with a path separator or when NoDefaultCurrentDirectoryInExePath is not
+ *    set in the environment (the documented behavior; the registry location the documentation also mentions is not read).
+ *  - HeapQueryInformation: ffmpeg.dll (loaded by every Electron renderer) and other images import it at load time. The only
+ *    class the heaps of this system answer is HeapCompatibilityInformation, always 0 (a standard heap: ntdll's allocator is not
+ *    a low-fragmentation heap, see RtlSetHeapInformation); any other class is ERROR_INVALID_PARAMETER, a handle that is no
+ *    heap is ERROR_INVALID_HANDLE.
+ */
+#include "k32.h"
+
+#ifndef APPMODEL_ERROR_NO_PACKAGE
+#define APPMODEL_ERROR_NO_PACKAGE 15700L
+#endif
+
+K32API BOOL WINAPI CancelSynchronousIo(HANDLE thread)
+{
+    DWORD exit;
+    if (!thread || thread == INVALID_HANDLE_VALUE || (thread != GetCurrentThread() && !GetExitCodeThread(thread, &exit))) {
+        shz_set_last_error(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    shz_set_last_error(ERROR_NOT_FOUND);
+    return FALSE;
+}
+
+K32API BOOLEAN WINAPI CreateSymbolicLinkW(LPCWSTR link, LPCWSTR target, DWORD flags)
+{
+    if (!link || !target || (flags & ~(DWORD)(SYMBOLIC_LINK_FLAG_DIRECTORY | SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE))) {
+        shz_set_last_error(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    shz_set_last_error(ERROR_NOT_SUPPORTED);
+    return FALSE;
+}
+
+K32API HANDLE WINAPI ReOpenFile(HANDLE orig, DWORD access, DWORD share, DWORD flags)
+{
+    WCHAR path[MAX_PATH + 8];
+    DWORD n = GetFinalPathNameByHandleW(orig, path, MAX_PATH + 8, 0);
+    if (!n) return INVALID_HANDLE_VALUE;                  /* LastError set by GetFinalPathNameByHandleW */
+    if (n >= MAX_PATH + 8) { shz_set_last_error(ERROR_FILENAME_EXCED_RANGE); return INVALID_HANDLE_VALUE; }
+    return CreateFileW(path, access, share, 0, OPEN_EXISTING, flags, 0);
+}
+
+K32API BOOL WINAPI GetProcessIoCounters(HANDLE process, PIO_COUNTERS counters)
+{
+    (void)process;
+    if (!counters) { shz_set_last_error(ERROR_NOACCESS); return FALSE; }
+    shz_set_last_error(ERROR_NOT_SUPPORTED);
+    return FALSE;
+}
+
+K32API LONG WINAPI GetCurrentPackageFullName(UINT32 *len, PWSTR name)
+{
+    (void)name;
+    if (!len) return ERROR_INVALID_PARAMETER;
+    return APPMODEL_ERROR_NO_PACKAGE;
+}
+
+K32API LONG WINAPI GetPackageFamilyName(HANDLE process, UINT32 *len, PWSTR name)
+{
+    (void)name;
+    if (!process || !len) return ERROR_INVALID_PARAMETER;
+    return APPMODEL_ERROR_NO_PACKAGE;
+}
+
+K32API BOOL WINAPI NeedCurrentDirectoryForExePathW(LPCWSTR exe)
+{
+    WCHAR v;
+    const WCHAR *p;
+    if (!exe) { shz_set_last_error(ERROR_INVALID_PARAMETER); return TRUE; }
+    for (p = exe; *p; ++p)
+        if (*p == '\\') return TRUE;
+    return GetEnvironmentVariableW(L"NoDefaultCurrentDirectoryInExePath", &v, 1) == 0;
+}
+
+K32API BOOL WINAPI HeapQueryInformation(HANDLE heap, HEAP_INFORMATION_CLASS cls, PVOID info, SIZE_T len, PSIZE_T needed)
+{
+    if ((int)cls != 0) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    if (!HeapValidate(heap, 0, NULL)) { shz_set_last_error(ERROR_INVALID_HANDLE); return FALSE; }
+    if (needed) *needed = sizeof(ULONG);
+    if (!info || len < sizeof(ULONG)) { shz_set_last_error(ERROR_INSUFFICIENT_BUFFER); return FALSE; }
+    *(ULONG *)info = 0;
+    return TRUE;
+}
diff --git a/shizukudos/win64/kernel32/k32_fiber.c b/shizukudos/win64/kernel32/k32_fiber.c
new file mode 100644
index 0000000..4502a43
--- /dev/null
+++ b/shizukudos/win64/kernel32/k32_fiber.c
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * kernel32.dll: fibers - ConvertThreadToFiber(Ex), ConvertFiberToThread, CreateFiber(Ex), DeleteFiber, SwitchToFiber.
+ *
+ * vk_swiftshader.dll (the software Vulkan driver Chromium's GPU process loads when there is no GPU) imports ConvertFiberToThread
+ * and its scheduler (marl) runs tasks on fibers; without the exports the DLL does not load and the GPU process dies.
+ *
+ * A fiber is a user-mode stack plus the registers that survive a call (rbx, rbp, rdi, rsi, r12-r15, xmm6-xmm15, MXCSR, the x87
+ * control word). SwitchToFiber saves those on the stack of the fiber it leaves, stores that stack pointer in the fiber object,
+ * and resumes the target from its stored stack pointer; the thread environment block is kept in step (stack bounds, FiberData,
+ * the fiber-local storage array) so exception dispatch, GetCurrentThreadStackLimits and FlsGetValue see the running fiber.
+ * The fiber object is laid out as Windows lays it out where programs can see it: its first member is the value GetFiberData
+ * returns, and TEB.NtTib.FiberData (0x20) points to the running fiber. Differences from Windows, each deliberate:
+ *  - a fiber stack is committed in full when it is created (there is no guard page and no growth): CreateFiberEx takes the
+ *    larger of the commit and reserve sizes, 1 MiB when both are 0;
+ *  - DeleteFiber frees the fiber-local storage array without running the FLS callbacks of its values;
+ *  - the FIBER_FLAG_FLOAT_SWITCH flag is accepted and ignored: the floating point state is always switched.
+ * Deleting the running fiber ends the thread (as on Windows); a fiber routine that returns also ends the thread.
+ */
+#include "k32.h"
+
+#define TEB_EXCEPTION_LIST 0x00
+#define TEB_STACK_BASE 0x08
+#define TEB_STACK_LIMIT 0x10
+#define TEB_FIBER_DATA 0x20
+#define TEB_DEALLOCATION_STACK 0x1478
+#define TEB_FLS_DATA 0x17c8
+#define TEB_SAME_TEB_FLAGS 0x17ee
+#define TEB_HAS_FIBER_DATA 4                                   /* SameTebFlags bit 2 */
+#define FIBER_DEFAULT_STACK (1024 * 1024)
+#define FIBER_MIN_STACK (16 * 1024)
+#define SWITCH_FRAME 232                                       /* 8 saved registers, xmm6-xmm15, MXCSR, FPU control word */
+
+typedef struct fiber {
+    PVOID data;                                                /* 0x00: what GetFiberData returns; must stay first */
+    uint64_t exception_list, stack_base, stack_limit, deallocation_stack, fls_data;   /* TEB fields while the fiber is switched out */
+    uint64_t saved_rsp;                                        /* top of the switch frame while it is switched out */
+    PVOID stack;                                               /* the allocation, NULL for a converted thread */
+    LPFIBER_START_ROUTINE start;
+} fiber_t;
+
+#define TEB_U64(off) (*(uint64_t *)(shz_teb() + (off)))
+static fiber_t *current_fiber(void)
+{
+    if (!(*(const USHORT *)(shz_teb() + TEB_SAME_TEB_FLAGS) & TEB_HAS_FIBER_DATA)) return NULL;
+    return (fiber_t *)(ULONG_PTR)TEB_U64(TEB_FIBER_DATA);
+}
+
+void k32_fiber_switch(uint64_t *save_rsp, uint64_t new_rsp);
+__asm__(".text\n.p2align 4\n"
+        "k32_fiber_switch:\n"
+        "  pushq %rbx\n  pushq %rbp\n  pushq %rdi\n  pushq %rsi\n  pushq %r12\n  pushq %r13\n  pushq %r14\n  pushq %r15\n"
+        "  subq $0xa8, %rsp\n"
+        "  movups %xmm6, 0(%rsp)\n  movups %xmm7, 16(%rsp)\n  movups %xmm8, 32(%rsp)\n  movups %xmm9, 48(%rsp)\n  movups %xmm10, 64(%rsp)\n"
+        "  movups %xmm11, 80(%rsp)\n  movups %xmm12, 96(%rsp)\n  movups %xmm13, 112(%rsp)\n  movups %xmm14, 128(%rsp)\n  movups %xmm15, 144(%rsp)\n"
+        "  stmxcsr 160(%rsp)\n  fnstcw 164(%rsp)\n"
+        "  movq %rsp, (%rcx)\n"
+        "  movq %rdx, %rsp\n"
+        "  ldmxcsr 160(%rsp)\n  fldcw 164(%rsp)\n"
+        "  movups 0(%rsp), %xmm6\n  movups 16(%rsp), %xmm7\n  movups 32(%rsp), %xmm8\n  movups 48(%rsp), %xmm9\n  movups 64(%rsp), %xmm10\n"
+        "  movups 80(%rsp), %xmm11\n  movups 96(%rsp), %xmm12\n  movups 112(%rsp), %xmm13\n  movups 128(%rsp), %xmm14\n  movups 144(%rsp), %xmm15\n"
+        "  addq $0xa8, %rsp\n"
+        "  popq %r15\n  popq %r14\n  popq %r13\n  popq %r12\n  popq %rsi\n  popq %rdi\n  popq %rbp\n  popq %rbx\n"
+        "  ret\n");
+
+static void save_teb(fiber_t *f)
+{
+    f->exception_list = TEB_U64(TEB_EXCEPTION_LIST);
+    f->stack_base = TEB_U64(TEB_STACK_BASE);
+    f->stack_limit = TEB_U64(TEB_STACK_LIMIT);
+    f->deallocation_stack = TEB_U64(TEB_DEALLOCATION_STACK);
+    f->fls_data = TEB_U64(TEB_FLS_DATA);
+}
+
+static void load_teb(fiber_t *f)
+{
+    TEB_U64(TEB_EXCEPTION_LIST) = f->exception_list;
+    TEB_U64(TEB_STACK_BASE) = f->stack_base;
+    TEB_U64(TEB_STACK_LIMIT) = f->stack_limit;
+    TEB_U64(TEB_DEALLOCATION_STACK) = f->deallocation_stack;
+    TEB_U64(TEB_FLS_DATA) = f->fls_data;
+    TEB_U64(TEB_FIBER_DATA) = (uint64_t)(ULONG_PTR)f;
+}
+
+__attribute__((noreturn, used)) static void fiber_main(void)
+{
+    fiber_t *f = (fiber_t *)TEB_U64(TEB_FIBER_DATA);
+    f->start(f->data);
+    ExitThread(0);
+    for (;;) { }
+}
+
+K32API LPVOID WINAPI ConvertThreadToFiberEx(LPVOID param, DWORD flags)
+{
+    fiber_t *f;
+    if (flags & ~(DWORD)FIBER_FLAG_FLOAT_SWITCH) { shz_set_last_error(ERROR_INVALID_PARAMETER); return NULL; }
+    if (current_fiber()) { shz_set_last_error(ERROR_ALREADY_FIBER); return NULL; }
+    f = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof *f);
+    if (!f) { shz_set_last_error(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    f->data = param;
+    save_teb(f);
+    TEB_U64(TEB_FIBER_DATA) = (uint64_t)(ULONG_PTR)f;
+    *(USHORT *)(shz_teb() + TEB_SAME_TEB_FLAGS) |= TEB_HAS_FIBER_DATA;
+    return f;
+}
+
+K32API LPVOID WINAPI ConvertThreadToFiber(LPVOID param) { return ConvertThreadToFiberEx(param, 0); }
+
+K32API BOOL WINAPI ConvertFiberToThread(void)
+{
+    fiber_t *f = current_fiber();
+    if (!f) { shz_set_last_error(ERROR_ALREADY_THREAD); return FALSE; }
+    if (f->stack) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }      /* only the fiber that came from the thread converts back */
+    *(USHORT *)(shz_teb() + TEB_SAME_TEB_FLAGS) &= (USHORT)~TEB_HAS_FIBER_DATA;
+    TEB_U64(TEB_FIBER_DATA) = 0;
+    HeapFree(GetProcessHeap(), 0, f);
+    return TRUE;
+}
+
+K32API LPVOID WINAPI CreateFiberEx(SIZE_T commit, SIZE_T reserve, DWORD flags, LPFIBER_START_ROUTINE start, LPVOID param)
+{
+    fiber_t *f;
+    SIZE_T size = commit > reserve ? commit : reserve;
+    uint64_t top, slot, frame;
+    uint64_t *w;
+    if ((flags & ~(DWORD)FIBER_FLAG_FLOAT_SWITCH) || !start) { shz_set_last_error(ERROR_INVALID_PARAMETER); return NULL; }
+    if (!size) size = FIBER_DEFAULT_STACK;
+    if (size < FIBER_MIN_STACK) size = FIBER_MIN_STACK;
+    size = (size + 0xfff) & ~(SIZE_T)0xfff;
+    f = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof *f);
+    if (!f) { shz_set_last_error(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    f->stack = VirtualAlloc(NULL, size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!f->stack) { HeapFree(GetProcessHeap(), 0, f); return NULL; }                  /* VirtualAlloc set the error */
+    f->data = param;
+    f->start = start;
+    f->stack_limit = f->deallocation_stack = (uint64_t)(ULONG_PTR)f->stack;
+    f->stack_base = (uint64_t)(ULONG_PTR)f->stack + size;
+    /* The first SwitchToFiber "returns" into fiber_main: lay out the frame it would have saved, with the return address of
+     * fiber_main (0, end of the call chain) and its 32 bytes of shadow space above. After the final `ret` rsp is 8 (mod 16), as
+     * at the first instruction of any called function. */
+    top = f->stack_base & ~(uint64_t)15;
+    slot = top - 0x30;                                          /* holds the address the switch returns to */
+    frame = slot - SWITCH_FRAME;
+    memset((void *)(ULONG_PTR)frame, 0, SWITCH_FRAME);
+    w = (uint64_t *)(ULONG_PTR)frame;
+    ((uint32_t *)w)[160 / 4] = 0x1f80;                          /* MXCSR: all exceptions masked, round to nearest */
+    ((uint16_t *)w)[164 / 2] = 0x27f;                           /* x87 control word: 53-bit precision, exceptions masked */
+    *(uint64_t *)(ULONG_PTR)slot = (uint64_t)(ULONG_PTR)fiber_main;
+    *(uint64_t *)(ULONG_PTR)(slot + 8) = 0;
+    f->saved_rsp = frame;
+    return f;
+}
+
+K32API LPVOID WINAPI CreateFiber(SIZE_T stack_size, LPFIBER_START_ROUTINE start, LPVOID param)
+{
+    return CreateFiberEx(stack_size, 0, 0, start, param);
+}
+
+K32API VOID WINAPI SwitchToFiber(LPVOID target)
+{
+    fiber_t *from = current_fiber(), *to = target;
+    if (!from || !to) return;
+    if (from == to) return;
+    save_teb(from);
+    load_teb(to);
+    k32_fiber_switch(&from->saved_rsp, to->saved_rsp);
+}
+
+K32API VOID WINAPI DeleteFiber(LPVOID fiber)
+{
+    fiber_t *f = fiber;
+    if (!f) return;
+    if (f == current_fiber()) ExitThread(0);                    /* a fiber that deletes itself ends the thread */
+    if (f->fls_data) HeapFree(GetProcessHeap(), 0, (PVOID)(ULONG_PTR)f->fls_data);
+    if (f->stack) VirtualFree(f->stack, 0, MEM_RELEASE);
+    HeapFree(GetProcessHeap(), 0, f);
+}
diff --git a/shizukudos/win64/kernel32/k32_file.c b/shizukudos/win64/kernel32/k32_file.c
index 81d52a9..7735a3a 100644
