+++ b/shizukudos/win64/kernel32/k32_file.c
@@ -452,8 +452,11 @@ K32API BOOL WINAPI WriteConsoleW(HANDLE h, const VOID *buf, DWORD n, LPDWORD wri
         DWORD chunk = n - off > 250 ? 250 : n - off, put;
         int len = wide_to_utf8(w + off, (int)chunk, tmp, sizeof tmp);
         if (len <= 0) break;
-        if (!WriteFile(h, tmp, (DWORD)len - 1, &put, 0)) return FALSE;
-        if (std_index(h) < 1) k32_console_track(tmp, (DWORD)len - 1);       /* WriteFile tracked the standard handles */
+        /* wide_to_utf8 with an explicit length returns the bytes it wrote, without a terminator (only a length of -1 counts the
