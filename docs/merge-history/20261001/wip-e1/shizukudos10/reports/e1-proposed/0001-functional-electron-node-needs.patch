 K32API BOOL WINAPI IsThreadAFiber(void)
 {
-    /* TEB.SameTebFlags (0x17ee) bit 2 is HasFiberData. ConvertThreadToFiber does not exist in this kernel32, so it is never set,
-     * but the flag is what Windows reports and what is read here. */
+    /* TEB.SameTebFlags (0x17ee) bit 2 is HasFiberData; ConvertThreadToFiber (k32_fiber.c) sets it and ConvertFiberToThread clears it. */
     return (*(const USHORT *)(shz_teb() + 0x17ee) & 4) != 0;
 }
 
diff --git a/shizukudos/win64/tests/t_k32_fiber.c b/shizukudos/win64/tests/t_k32_fiber.c
new file mode 100644
index 0000000..0c51727
--- /dev/null
+++ b/shizukudos/win64/tests/t_k32_fiber.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Fibers (kernel32: ConvertThreadToFiber(Ex), ConvertFiberToThread, CreateFiber(Ex), DeleteFiber, SwitchToFiber). The expected
+ * values come from the documented behaviour: the order in which control passes, GetFiberData/GetCurrentFiber, the error codes
+ * (ERROR_ALREADY_FIBER, ERROR_ALREADY_THREAD), a separate stack and fiber-local storage per fiber, that a fiber routine which returns
+ * ends the thread, and that the registers a called function must preserve (rbx, rbp, rdi, rsi, r12-r15, xmm6-xmm15) survive a
+ * switch in both directions - checked with routines written in assembly that load known values, switch, and compare.
+ */
+#include "k32test.h"
+
+static LPVOID g_main, g_a, g_b;
+static int g_log[16], g_nlog;
+static volatile LONG g_after_switch, g_thread_fiber_ran;
+static DWORD g_fls;
+static DWORD64 g_reg_fail_fiber;
+
+/* GetCurrentFiber() / GetFiberData() of the SDK read gs:[0x20] (NtTib.FiberData) and the value it points to; written out here because
+ * GCC rejects the SDK's __readgsqword(0x20) under -Werror=array-bounds. */
+static LPVOID cur_fiber(void) { LPVOID v; __asm__ volatile("movq %%gs:0x20, %0" : "=r"(v)); return v; }
+static LPVOID fiber_data(void) { return *(LPVOID *)cur_fiber(); }
+
+static void note(int v) { if (g_nlog < 16) g_log[g_nlog++] = v; }
+
+/* check_regs(fiber): loads known values into the preserved registers, switches to `fiber`, compares them when control returns;
+ * returns 0 when all are intact, else a bit per register that changed. trash_and_switch(fiber): the same from the other side with
+ * different values (the fiber loads its own values, switches back to `fiber`, and compares them when it is resumed). */
+DWORD64 check_regs(LPVOID fiber);
+DWORD64 trash_and_switch(LPVOID fiber);
+#define REG_BODY(name, K1, K2, K3, K4, K5, K6, K7, X0, X1) \
+    __asm__(".text\n.globl " #name "\n" #name ":\n" \
+        "  pushq %rbx\n  pushq %rbp\n  pushq %rdi\n  pushq %rsi\n  pushq %r12\n  pushq %r13\n  pushq %r14\n  pushq %r15\n" \
+        "  subq $0x48, %rsp\n  movups %xmm6, 0x20(%rsp)\n  movups %xmm15, 0x30(%rsp)\n" \
+        "  movq $" #K1 ", %rbx\n  movq $" #K2 ", %rbp\n  movq $" #K3 ", %rdi\n  movq $" #K4 ", %rsi\n" \
+        "  movq $" #K5 ", %r12\n  movq $" #K6 ", %r13\n  movq $" #K7 ", %r14\n  movq $" #K1 ", %r15\n" \
+        "  movq $" #X0 ", %rax\n  movq %rax, 0(%rsp)\n  movq %rax, 8(%rsp)\n  movups 0(%rsp), %xmm6\n" \
+        "  movq $" #X1 ", %rax\n  movq %rax, 0(%rsp)\n  movq %rax, 8(%rsp)\n  movups 0(%rsp), %xmm15\n" \
+        "  subq $0x20, %rsp\n  call SwitchToFiber\n  addq $0x20, %rsp\n" \
+        "  xorl %eax, %eax\n" \
+        "  movq $" #K1 ", %rcx\n  cmpq %rcx, %rbx\n  je 1f\n  orq $1, %rax\n1:\n" \
+        "  movq $" #K2 ", %rcx\n  cmpq %rcx, %rbp\n  je 2f\n  orq $2, %rax\n2:\n" \
+        "  movq $" #K3 ", %rcx\n  cmpq %rcx, %rdi\n  je 3f\n  orq $4, %rax\n3:\n" \
+        "  movq $" #K4 ", %rcx\n  cmpq %rcx, %rsi\n  je 4f\n  orq $8, %rax\n4:\n" \
+        "  movq $" #K5 ", %rcx\n  cmpq %rcx, %r12\n  je 5f\n  orq $16, %rax\n5:\n" \
+        "  movq $" #K6 ", %rcx\n  cmpq %rcx, %r13\n  je 6f\n  orq $32, %rax\n6:\n" \
+        "  movq $" #K7 ", %rcx\n  cmpq %rcx, %r14\n  je 7f\n  orq $64, %rax\n7:\n" \
+        "  movq $" #K1 ", %rcx\n  cmpq %rcx, %r15\n  je 8f\n  orq $128, %rax\n8:\n" \
+        "  movups %xmm6, 0(%rsp)\n  movq $" #X0 ", %rcx\n  cmpq %rcx, 0(%rsp)\n  jne 9f\n  cmpq %rcx, 8(%rsp)\n  je 10f\n9:\n  orq $256, %rax\n10:\n" \
+        "  movups %xmm15, 0(%rsp)\n  movq $" #X1 ", %rcx\n  cmpq %rcx, 0(%rsp)\n  jne 11f\n  cmpq %rcx, 8(%rsp)\n  je 12f\n11:\n  orq $512, %rax\n12:\n" \
+        "  movups 0x20(%rsp), %xmm6\n  movups 0x30(%rsp), %xmm15\n  addq $0x48, %rsp\n" \
+        "  popq %r15\n  popq %r14\n  popq %r13\n  popq %r12\n  popq %rsi\n  popq %rdi\n  popq %rbp\n  popq %rbx\n  ret\n");
+REG_BODY(check_regs, 0x1111111, 0x2222222, 0x3333333, 0x4444444, 0x5555555, 0x6666666, 0x7777777, 0x1234567, 0x7654321)
+REG_BODY(trash_and_switch, 0x0a0a0a0, 0x0b0b0b0, 0x0c0c0c0, 0x0d0d0d0, 0x0e0e0e0, 0x0f0f0f0, 0x0101010, 0x0abcdef, 0x0fedcba)
+
+static VOID WINAPI fiber_a(LPVOID p)
+{
+    int local = 0x5a5a;
+    note(100 + (int)(ULONG_PTR)p);
+    SwitchToFiber(g_main);                                     /* 1: back to the main fiber */
+    note(200);
+    CHECK(local == 0x5a5a, "a local of the fiber survives a switch (its stack is its own)");
+    CHECK(fiber_data() == p && cur_fiber() == g_a, "the FiberData of the TEB (GetFiberData / GetCurrentFiber) inside the fiber");
+    CHECK(IsThreadAFiber(), "IsThreadAFiber inside a fiber");
+    CHECK(FlsGetValue(g_fls) == NULL, "a new fiber starts with empty fiber-local storage");
+    FlsSetValue(g_fls, (PVOID)0xaaa);
+    SwitchToFiber(g_main);                                     /* 2 */
+    CHECK(FlsGetValue(g_fls) == (PVOID)0xaaa, "the fiber's own FLS value is back after the main fiber ran");
+    g_reg_fail_fiber = trash_and_switch(g_main);               /* 3: registers of the fiber across a switch (run by main in check_regs) */
+    note(300);
+    SwitchToFiber(g_main);                                     /* 4 */
+    note(999);                                                 /* never resumed */
+}
+
+static VOID WINAPI fiber_b(LPVOID p)
+{
+    ULONG_PTR low = 0, high = 0, here = (ULONG_PTR)&low;
+    note(400);
+    GetCurrentThreadStackLimits(&low, &high);
+    CHECKV(here >= low && here < high, "GetCurrentThreadStackLimits inside a fiber bounds a local of that fiber", "%p not in [%p, %p)", (void *)here, (void *)low, (void *)high);
+    SwitchToFiber(g_a);                                        /* a fiber created by another fiber resumes the other fiber */
+    note(999);
+}
+
+static VOID WINAPI ending_fiber(LPVOID p)
+{
+    InterlockedExchange(&g_thread_fiber_ran, 7);
+    (void)p;                                                   /* returns: the thread must end here */
+}
+
+static DWORD WINAPI thread_with_fibers(LPVOID p)
+{
+    LPVOID self = ConvertThreadToFiber(NULL), f = CreateFiber(0, ending_fiber, NULL);
+    (void)p;
+    if (self && f) SwitchToFiber(f);
+    InterlockedExchange(&g_after_switch, 1);                   /* must not run */
+    return 5;
+}
+
+int main(void)
+{
+    ULONG_PTR low0 = 0, high0 = 0, low1 = 0, high1 = 0;
+    DWORD64 bits;
+    HANDLE th;
+    DWORD code = 0xdead;
+    int i;
+    CHECK(!IsThreadAFiber(), "a thread is not a fiber at the start");
+    SetLastError(0);
+    CHECK(CreateFiber(0, NULL, NULL) == NULL && GetLastError() == ERROR_INVALID_PARAMETER, "CreateFiber without a routine fails with ERROR_INVALID_PARAMETER");
+    SetLastError(0);
+    CHECK(!ConvertFiberToThread() && GetLastError() == ERROR_ALREADY_THREAD, "ConvertFiberToThread on a plain thread fails with ERROR_ALREADY_THREAD");
+    g_main = ConvertThreadToFiber((LPVOID)0x1234);
+    CHECK(g_main != NULL, "ConvertThreadToFiber");
+    CHECK(IsThreadAFiber() && cur_fiber() == g_main && fiber_data() == (LPVOID)0x1234, "IsThreadAFiber and the TEB's fiber and data after the conversion");
+    SetLastError(0);
+    CHECK(ConvertThreadToFiber(NULL) == NULL && GetLastError() == ERROR_ALREADY_FIBER, "a second ConvertThreadToFiber fails with ERROR_ALREADY_FIBER");
+    GetCurrentThreadStackLimits(&low0, &high0);
+    g_fls = FlsAlloc(NULL);
+    CHECK(g_fls != FLS_OUT_OF_INDEXES, "FlsAlloc");
+    FlsSetValue(g_fls, (PVOID)0x111);
+
+    g_a = CreateFiber(64 * 1024, fiber_a, (LPVOID)7);
+    g_b = CreateFiberEx(32 * 1024, 128 * 1024, 0, fiber_b, NULL);
+    CHECK(g_a != NULL && g_b != NULL && g_a != g_b, "CreateFiber / CreateFiberEx");
+    SwitchToFiber(g_a);                                        /* a runs up to its first switch */
+    note(1);
+    SwitchToFiber(g_a);                                        /* 200 ... second switch */
+    note(2);
+    CHECK(FlsGetValue(g_fls) == (PVOID)0x111, "the main fiber's FLS value is unchanged by what the other fiber stored");
+    CHECK(cur_fiber() == g_main, "the main fiber is current again");
+    GetCurrentThreadStackLimits(&low1, &high1);
+    CHECK(low0 == low1 && high0 == high1, "the thread's stack bounds are restored when the main fiber runs again");
+    bits = check_regs(g_a);                                    /* the fiber's third switch: both sides compare their registers */
+    CHECKV(bits == 0 && g_reg_fail_fiber == 0, "rbx, rbp, rdi, rsi, r12-r15, xmm6 and xmm15 survive a switch in both directions", "main side bits %llx, fiber side bits %llx", (unsigned long long)bits, (unsigned long long)g_reg_fail_fiber);
+    note(3);
+    SwitchToFiber(g_b);                                        /* b checks its stack bounds, switches to a (resumes after the trash_and_switch), a notes 300 and returns to main */
+    note(4);
+    {
+        static const int want[] = {107, 1, 200, 2, 3, 400, 300, 4};
+        int ok = g_nlog == 8;
+        for (i = 0; ok && i < 8; ++i) if (g_log[i] != want[i]) ok = 0;
+        CHECKV(ok, "control passes in the order the switches say", "%d entries: %d %d %d %d %d %d %d %d", g_nlog, g_log[0], g_log[1], g_log[2], g_log[3], g_log[4], g_log[5], g_log[6], g_log[7]);
+    }
+    DeleteFiber(g_a);
+    DeleteFiber(g_b);
+    CHECK(TRUE, "DeleteFiber of fibers that are not running");
+
+    th = CreateThread(NULL, 0, thread_with_fibers, NULL, 0, NULL);
+    CHECK(th != NULL, "CreateThread for the fiber routine that returns");
+    CHECK(th && WaitForSingleObject(th, 20000) == WAIT_OBJECT_0, "the thread ends when its fiber routine returns");
+    CHECK(th && GetExitCodeThread(th, &code) && code == 0, "with exit code 0");
+    CHECK(g_thread_fiber_ran == 7 && g_after_switch == 0, "the code after the switch in the thread never ran");
+    if (th) CloseHandle(th);
+
+    CHECK(ConvertFiberToThread(), "ConvertFiberToThread");
+    CHECK(!IsThreadAFiber(), "IsThreadAFiber is false again");
+    SetLastError(0);
+    CHECK(!ConvertFiberToThread() && GetLastError() == ERROR_ALREADY_THREAD, "ConvertFiberToThread twice fails with ERROR_ALREADY_THREAD");
+    return k32t_finish("t_k32_fiber");
+}
