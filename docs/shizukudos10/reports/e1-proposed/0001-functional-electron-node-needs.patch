+/* Growable tables (Windows 8+; V8 registers the unwind info of its code range with them): the caller owns a RUNTIME_FUNCTION
+ * array sorted by address, registered for [RangeBase, RangeEnd) with `count` valid entries out of `max`, and raises the count
+ * with RtlGrowFunctionTable as it appends entries. RUNTIME_FUNCTION RVAs are from RangeBase. They live in the same registry
+ * as RtlAddFunctionTable tables, so RtlLookupFunctionEntry and the unwinder find them with no other change; the handle
+ * returned through DynamicTable is the address of the registry slot. */
+SHZ_EXPORT DWORD NTAPI RtlAddGrowableFunctionTable(PVOID *dynamic_table, PRUNTIME_FUNCTION table, DWORD count, DWORD max,
+                                                      ULONG_PTR range_base, ULONG_PTR range_end)
+{
+    unsigned i;
+    if (!dynamic_table || count > max || range_end <= range_base || (count && !table)) return 0xC000000DUL;        /* STATUS_INVALID_PARAMETER */
+    dyn_acquire();
+    for (i = 0; i < 128; ++i)
+        if (!dyn_tables[i].used) {
+            dyn_tables[i] = (dyn_table_t){ table, count, range_base, range_end - range_base, 0, 0, 0, 1, 1 };
+            *dynamic_table = &dyn_tables[i];
+            dyn_release();
+            return 0;                /* STATUS_SUCCESS */
+        }
+    dyn_release();
+    return 0xC0000017UL;         /* STATUS_NO_MEMORY */
+}
+
+SHZ_EXPORT VOID NTAPI RtlGrowFunctionTable(PVOID dynamic_table, DWORD new_count)
+{
+    dyn_table_t *t = dynamic_table;
+    dyn_acquire();
+    if (t >= dyn_tables && t < dyn_tables + 128 && t->used && t->growable && new_count > t->count) t->count = new_count;
+    dyn_release();
+}
+
+SHZ_EXPORT VOID NTAPI RtlDeleteGrowableFunctionTable(PVOID dynamic_table)
+{
+    dyn_table_t *t = dynamic_table;
+    dyn_acquire();
+    if (t >= dyn_tables && t < dyn_tables + 128 && t->used && t->growable) t->used = 0;
+    dyn_release();
+}
