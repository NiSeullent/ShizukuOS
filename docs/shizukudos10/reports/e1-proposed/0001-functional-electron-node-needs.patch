+/* SPDX-License-Identifier: GPL-2.0-only
+ * advapi32.dll: SystemFunction036 (RtlGenRandom), what the C runtime's rand_s, V8's random number generator seeding and
+ * Chromium's base::RandBytes look up by name in advapi32. Same source as BCryptGenRandom: the kernel generator
+ * (shz_rand.h, NtShzRandom). Windows returns TRUE when the buffer was filled; a NULL buffer or one the kernel cannot write fails.
+ */
+#define _ADVAPI32_
+#include "nt.h"
+#include "shz_rand.h"
+
+DLLAPI BOOLEAN WINAPI SystemFunction036(PVOID buffer, ULONG length)
+{
+    if (!length) return TRUE;
+    if (!buffer) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    return shz_random_bytes(buffer, length) ? TRUE : FALSE;
+}
