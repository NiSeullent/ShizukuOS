+/* GetNameInfoW: IPv4 only. There is no reverse DNS in the kernel resolver (NtShzNetResolve answers A-record lookups), so the host
+ * comes back in numeric form, which is also what Windows does for an address with no name; NI_NAMEREQD therefore fails with
+ * WSAHOST_NOT_FOUND. The service is the decimal port, or the name from the built-in table unless NI_NUMERICSERV is set. */
+DLLAPI INT WSAAPI GetNameInfoW(const SOCKADDR *sa, socklen_t salen, PWCHAR host, DWORD hostlen, PWCHAR serv, DWORD servlen, INT flags)
+{
+    const struct sockaddr_in *in4 = (const struct sockaddr_in *)sa;
+    char text[16], port[8];
+    unsigned i, n, p;
+    NEED_INIT(WSANOTINITIALISED);
+    if (!sa || (salen < (socklen_t)sizeof *in4)) { SetLastError(WSAEFAULT); return WSAEFAULT; }
+    if (sa->sa_family != AF_INET) { SetLastError(WSAEAFNOSUPPORT); return WSAEAFNOSUPPORT; }
+    if ((!host || !hostlen) && (!serv || !servlen)) { SetLastError(WSAEINVAL); return WSAEINVAL; }
+    if (flags & ~(NI_NOFQDN | NI_NUMERICHOST | NI_NAMEREQD | NI_NUMERICSERV | NI_DGRAM)) { SetLastError(WSAEINVAL); return WSAEINVAL; }
+    if (host && hostlen) {
+        const unsigned char *a = (const unsigned char *)&in4->sin_addr;
+        if (flags & NI_NAMEREQD) { SetLastError(WSAHOST_NOT_FOUND); return WSAHOST_NOT_FOUND; }
+        for (i = 0, n = 0; i < 4; ++i) {
+            unsigned v = a[i], d = v >= 100 ? 3 : v >= 10 ? 2 : 1, k;
+            for (k = d; k > 0; --k) { text[n + k - 1] = (char)('0' + v % 10); v /= 10; }
+            n += d;
+            if (i < 3) text[n++] = '.';
+        }
+        if (n + 1 > hostlen) { SetLastError(WSAEFAULT); return WSAEFAULT; }
+        for (i = 0; i < n; ++i) host[i] = (WCHAR)text[i];
+        host[n] = 0;
+    }
+    if (serv && servlen) {
+        const char *name = 0;
+        p = ntohs(in4->sin_port);
+        if (!(flags & NI_NUMERICSERV))
+            for (i = 0; services[i].name; ++i)
+                if (services[i].port == p) { name = services[i].name; break; }
+        if (name) {
+            n = (unsigned)strlen(name);
+            if (n + 1 > servlen) { SetLastError(WSAEFAULT); return WSAEFAULT; }
+            for (i = 0; i < n; ++i) serv[i] = (WCHAR)name[i];
+        } else {
+            unsigned v = p, d = v >= 10000 ? 5 : v >= 1000 ? 4 : v >= 100 ? 3 : v >= 10 ? 2 : 1, k;
+            for (k = d; k > 0; --k) { port[k - 1] = (char)('0' + v % 10); v /= 10; }
+            n = d;
+            if (n + 1 > servlen) { SetLastError(WSAEFAULT); return WSAEFAULT; }
+            for (i = 0; i < n; ++i) serv[i] = (WCHAR)port[i];
+        }
+        serv[n] = 0;
+    }
+    return 0;
+}
