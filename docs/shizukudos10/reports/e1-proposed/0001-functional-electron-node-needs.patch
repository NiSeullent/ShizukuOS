 {
     char node[260], service[64];
diff --git a/shizukudos/win64/kernel32/k32_console.c b/shizukudos/win64/kernel32/k32_console.c
index aab76ee..5ae5a9c 100644
--- a/shizukudos/win64/kernel32/k32_console.c
+++ b/shizukudos/win64/kernel32/k32_console.c
@@ -192,3 +192,119 @@ K32API BOOL WINAPI SetConsoleCtrlHandler(PHANDLER_ROUTINE fn, BOOL add)
     if (!ok) shz_set_last_error(ERROR_INVALID_PARAMETER);
     return ok;
 }
+
+/* ---------------------------------------------------------------- cursor, title, cell fills and the input queue
+ * Same model as above: the serial console has neither a cell store, a cursor shape, a title bar nor an input queue, so these
+ * keep the model a Windows program expects and change nothing on the line.
+ *  - SetConsoleCursorPosition moves the modelled cursor (the next WriteConsole continues from it); the position must lie
+ *    inside the 80x25 buffer. Get/SetConsoleCursorInfo keep the cursor size and visibility.
+ *  - FillConsoleOutputCharacterW / FillConsoleOutputAttribute report the cells of the buffer they could reach (clipped at the
+ *    end of the buffer, as Windows does); no cell contents exist to change.
+ *  - SetConsoleTitleW keeps the title (there is no title bar to show it).
+ *  - The console has no input source (reads report end of file): it holds no input events, ReadConsoleInputW reports
+ *    ERROR_HANDLE_EOF instead of blocking forever, and WriteConsoleInputW, which needs an input queue to write into, fails
+ *    with ERROR_NOT_SUPPORTED.
+ */
+static DWORD g_cursor_size = 25;
+static BOOL g_cursor_visible = TRUE;
+static WCHAR g_title[256];
+
+static BOOL in_handle(HANDLE h)
+{
+    DWORD mode;
+    if (g_detached || !GetConsoleMode(h, &mode)) { shz_set_last_error(ERROR_INVALID_HANDLE); return FALSE; }
+    return TRUE;
+}
+
+K32API BOOL WINAPI SetConsoleCursorPosition(HANDLE h, COORD pos)
+{
+    if (!out_handle(h)) return FALSE;
+    if (pos.X < 0 || pos.X >= CON_COLS || pos.Y < 0 || pos.Y >= CON_ROWS) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    AcquireSRWLockExclusive(&g_con_lock);
+    g_x = pos.X; g_y = pos.Y;
+    ReleaseSRWLockExclusive(&g_con_lock);
+    return TRUE;
+}
+
+K32API BOOL WINAPI GetConsoleCursorInfo(HANDLE h, PCONSOLE_CURSOR_INFO info)
+{
+    if (!out_handle(h)) return FALSE;
+    if (!info) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    AcquireSRWLockShared(&g_con_lock);
+    info->dwSize = g_cursor_size; info->bVisible = g_cursor_visible;
+    ReleaseSRWLockShared(&g_con_lock);
+    return TRUE;
+}
+
+K32API BOOL WINAPI SetConsoleCursorInfo(HANDLE h, const CONSOLE_CURSOR_INFO *info)
+{
+    if (!out_handle(h)) return FALSE;
+    if (!info || info->dwSize < 1 || info->dwSize > 100) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    AcquireSRWLockExclusive(&g_con_lock);
+    g_cursor_size = info->dwSize; g_cursor_visible = info->bVisible;
+    ReleaseSRWLockExclusive(&g_con_lock);
+    return TRUE;
+}
+
+static BOOL fill_reach(HANDLE h, DWORD len, COORD at, LPDWORD written)
+{
+    DWORD room;
+    if (!out_handle(h)) return FALSE;
+    if (!written) { shz_set_last_error(ERROR_INVALID_ACCESS); return FALSE; }
+    if (at.X < 0 || at.X >= CON_COLS || at.Y < 0 || at.Y >= CON_ROWS) { *written = 0; return TRUE; }   /* outside: no cell is reached */
+    room = (DWORD)(CON_ROWS - at.Y) * CON_COLS - (DWORD)at.X;
+    *written = len < room ? len : room;
+    return TRUE;
+}
+
+K32API BOOL WINAPI FillConsoleOutputCharacterW(HANDLE h, WCHAR ch, DWORD len, COORD at, LPDWORD written)
+{
+    (void)ch;
+    return fill_reach(h, len, at, written);
+}
+
+K32API BOOL WINAPI FillConsoleOutputAttribute(HANDLE h, WORD attr, DWORD len, COORD at, LPDWORD written)
+{
+    (void)attr;
+    return fill_reach(h, len, at, written);
+}
+
+K32API BOOL WINAPI SetConsoleTitleW(LPCWSTR title)
+{
+    size_t n = 0;
+    if (g_detached) { shz_set_last_error(ERROR_INVALID_HANDLE); return FALSE; }
+    if (!title) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    while (title[n]) ++n;
+    if (n > 255) n = 255;
+    AcquireSRWLockExclusive(&g_con_lock);
+    memcpy(g_title, title, n * sizeof(WCHAR));
+    g_title[n] = 0;
+    ReleaseSRWLockExclusive(&g_con_lock);
+    return TRUE;
+}
+
+K32API BOOL WINAPI GetNumberOfConsoleInputEvents(HANDLE h, LPDWORD n)
+{
+    if (!in_handle(h)) return FALSE;
+    if (!n) { shz_set_last_error(ERROR_INVALID_ACCESS); return FALSE; }
+    *n = 0;
+    return TRUE;
+}
+
+K32API BOOL WINAPI ReadConsoleInputW(HANDLE h, PINPUT_RECORD buf, DWORD len, LPDWORD got)
+{
+    if (!in_handle(h)) return FALSE;
+    if (!buf || !got || !len) { shz_set_last_error(ERROR_INVALID_PARAMETER); return FALSE; }
+    *got = 0;
+    shz_set_last_error(ERROR_HANDLE_EOF);                 /* no input source: Windows would block, this console never delivers */
+    return FALSE;
+}
+
+K32API BOOL WINAPI WriteConsoleInputW(HANDLE h, const INPUT_RECORD *buf, DWORD len, LPDWORD written)
+{
+    (void)buf; (void)len;
+    if (!in_handle(h)) return FALSE;
+    if (written) *written = 0;
+    shz_set_last_error(ERROR_NOT_SUPPORTED);              /* there is no input queue to write into */
+    return FALSE;
+}
