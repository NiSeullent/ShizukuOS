+/* SPDX-License-Identifier: GPL-2.0-only
+ * d3d12.dll - "no Direct3D 12 driver": D3D12CreateDevice fails with DXGI_ERROR_UNSUPPORTED (see dxgi.dll). The
+ * program in this repository's test set that imports d3d12.dll by ordinal (Chromium/Electron, ordinal 101) only
+ * needs the import to resolve; the function pinned at 101 here is a stub with that same failure, and which Windows
+ * export really sits at 101 has not been verified. */
+#include "nt.h"
+
+#define DXGI_ERROR_UNSUPPORTED_ ((HRESULT)0x887A0004)
+
+DLLAPI HRESULT WINAPI D3D12CreateDevice(void *adapter, UINT min_level, const void *riid, void **device)
+{
+    (void)adapter; (void)min_level; (void)riid;
+    if (device) *device = 0;
+    return DXGI_ERROR_UNSUPPORTED_;
+}
+
+DLLAPI HRESULT WINAPI D3D12GetDebugInterface(const void *riid, void **debug)
+{
+    (void)riid;
+    if (debug) *debug = 0;
+    return DXGI_ERROR_UNSUPPORTED_;
+}
+
+DLLAPI HRESULT WINAPI D3D12UnverifiedOrdinal101(void *a, void *b, void *c, void *d)
+{
+    (void)a; (void)b; (void)c; (void)d;
+    return DXGI_ERROR_UNSUPPORTED_;
+}
