diff --git a/shizukudos/win64/dlls/d3d11/d3d11.c b/shizukudos/win64/dlls/d3d11/d3d11.c
new file mode 100644
index 0000000..6947958
--- /dev/null
+++ b/shizukudos/win64/dlls/d3d11/d3d11.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * d3d11.dll - "no Direct3D 11 driver": device creation fails with DXGI_ERROR_UNSUPPORTED and leaves the out
+ * parameters NULL (see dxgi.dll). */
+#include "nt.h"
+
+#define DXGI_ERROR_UNSUPPORTED_ ((HRESULT)0x887A0004)
+
+DLLAPI HRESULT WINAPI D3D11CreateDevice(void *adapter, UINT driver_type, HMODULE software, UINT flags, const UINT *levels,
+                                        UINT n_levels, UINT sdk_version, void **device, UINT *level, void **context)
+{
+    (void)adapter; (void)driver_type; (void)software; (void)flags; (void)levels; (void)n_levels; (void)sdk_version;
+    if (device) *device = 0;
+    if (level) *level = 0;
+    if (context) *context = 0;
+    return DXGI_ERROR_UNSUPPORTED_;
+}
+
+DLLAPI HRESULT WINAPI D3D11CreateDeviceAndSwapChain(void *adapter, UINT driver_type, HMODULE software, UINT flags, const UINT *levels,
+                                                    UINT n_levels, UINT sdk_version, const void *swap_desc, void **swap_chain,
+                                                    void **device, UINT *level, void **context)
+{
+    (void)swap_desc;
+    if (swap_chain) *swap_chain = 0;
+    return D3D11CreateDevice(adapter, driver_type, software, flags, levels, n_levels, sdk_version, device, level, context);
+}
diff --git a/shizukudos/win64/dlls/d3d12/d3d12.c b/shizukudos/win64/dlls/d3d12/d3d12.c
