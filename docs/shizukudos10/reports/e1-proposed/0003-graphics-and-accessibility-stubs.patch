+/* SPDX-License-Identifier: GPL-2.0-only
+ * dcomp.dll - "no DirectComposition": the device and surface-handle factories fail with E_NOTIMPL, leaving the out
+ * parameters NULL, so a caller that probes for DirectComposition (Chromium's compositor) sees it is unavailable. */
+#include "nt.h"
+
+#define E_NOTIMPL_ ((HRESULT)0x80004001)
+
+DLLAPI HRESULT WINAPI DCompositionCreateDevice(void *dxgi_device, const void *riid, void **device)
+{
+    (void)dxgi_device; (void)riid;
+    if (device) *device = 0;
+    return E_NOTIMPL_;
+}
+
+DLLAPI HRESULT WINAPI DCompositionCreateSurfaceHandle(DWORD access, void *attrs, HANDLE *handle)
+{
+    (void)access; (void)attrs;
+    if (handle) *handle = 0;
+    return E_NOTIMPL_;
+}
