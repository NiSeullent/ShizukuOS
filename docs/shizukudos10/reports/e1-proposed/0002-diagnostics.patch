+/* `shz.exctrace`: one line per NtCreateFile/NtOpenFile with the path it was asked for and its status (at most 900 per boot), so a
+ * program that gives up on a missing file or a path form this system does not know leaves the name behind. Expected
+ * probes (a missing optional file) show up too: the status says which kind of failure it was. */
+static int32_t trace_open_failure(process_t *p, uint32_t num, uint64_t oa_uva, int32_t st)
+{
+    static int enabled = -1;
+    static unsigned lines;
+    struct objattr oa;
+    char path[300];
+    if (enabled < 0) enabled = k64_cmdline_has("shz.exctrace");
+    if (!enabled || lines >= 900) return st;
+    if (copy_from_user(p, &oa, oa_uva, sizeof oa) || !oa.name || read_ustr(p, oa.name, path, sizeof path)) return st;
+    ++lines;
+    kprintf("K64 fs: pid %d %s %s -> %x\n", p->pid, num == SYS_NtOpenFile ? "NtOpenFile" : "NtCreateFile", path, (uint32_t)st);
+    return st;
+}
+
 int32_t sysfile_dispatch(process_t *p, struct regs *r, uint32_t num, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4,
                          int *handled)
 {
@@ -825,8 +842,8 @@ int32_t sysfile_dispatch(process_t *p, struct regs *r, uint32_t num, uint64_t a1
         if (ntdrv_file_dispatch(p, r, num, a1, &dst)) return dst;
     }
     switch (num) {
-    case SYS_NtCreateFile: return sys_create_file(p, r, a1, a2, a3, a4, 0);
-    case SYS_NtOpenFile: return sys_create_file(p, r, a1, a2, a3, a4, 1);
+    case SYS_NtCreateFile: return trace_open_failure(p, num, a3, sys_create_file(p, r, a1, a2, a3, a4, 0));
+    case SYS_NtOpenFile: return trace_open_failure(p, num, a3, sys_create_file(p, r, a1, a2, a3, a4, 1));
     case SYS_NtReadFile: return sys_rw_file(p, r, a1, 0);
     case SYS_NtWriteFile: return sys_rw_file(p, r, a1, 1);
     case SYS_NtQueryInformationFile: return sys_query_info_file(p, r, a1, a2, a3, a4);
