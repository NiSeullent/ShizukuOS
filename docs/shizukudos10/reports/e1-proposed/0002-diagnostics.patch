+/* Extra environment variables of the autorun process, from `env=NAME=VALUE` lines of the control file, as "N=V\0N=V\0" (the loader
+ * appends them to the default environment of the process it creates; ldr.c build_params). Empty outside an autorun. */
+char k64_autorun_env[512];
+
+static void add_env(const char *v, size_t vl)
+{
+    size_t used = 0;
+    while (used < sizeof k64_autorun_env - 1 && k64_autorun_env[used]) used += strlen(k64_autorun_env + used) + 1;
+    if (!vl || used + vl + 2 > sizeof k64_autorun_env) return;
+    memcpy(k64_autorun_env + used, v, vl);
+    k64_autorun_env[used + vl] = 0;
+    k64_autorun_env[used + vl + 1] = 0;
+}
