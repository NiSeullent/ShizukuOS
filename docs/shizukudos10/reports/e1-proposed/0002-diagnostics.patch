diff --git a/shizukudos/win64/kernel32/k32_trace.c b/shizukudos/win64/kernel32/k32_trace.c
index fbe85bc..52adfba 100644
--- a/shizukudos/win64/kernel32/k32_trace.c
+++ b/shizukudos/win64/kernel32/k32_trace.c
@@ -81,3 +81,71 @@ void k32_trace_hex(const char *a, const char *b, ULONG_PTR v)
     line[n++] = '\n';
     NtShzDebugPrint(line, n);
 }
+
+
+/* Who ended the process: "K32 trace: <what> code=0x<code> caller=0x<pc> image=0x<base> rva=0x<pc-base>". The return address of the
+ * exit call names the code that gave up (the image's base lets the host turn it into an RVA). */
+void k32_trace_exit(const char *what, ULONG_PTR code, void *caller)
+{
+    char line[240];
+    unsigned n = 0;
+    PVOID base = 0;
+    if (!k32_trace_on()) return;
+    RtlPcToFileHeader(caller, &base);
+    n = put(line, n, sizeof line, "K32 trace: ");
+    n = put(line, n, sizeof line, what);
+    n = put(line, n, sizeof line, " code=0x");
+    n = put_hex(line, n, sizeof line, code);
+    n = put(line, n, sizeof line, " caller=0x");
+    n = put_hex(line, n, sizeof line, (ULONG_PTR)caller);
+    n = put(line, n, sizeof line, " image=0x");
+    n = put_hex(line, n, sizeof line, (ULONG_PTR)base);
+    n = put(line, n, sizeof line, " rva=0x");
+    n = put_hex(line, n, sizeof line, base ? (ULONG_PTR)caller - (ULONG_PTR)base : 0);
+    line[n++] = '\n';
+    NtShzDebugPrint(line, n);
+    {   /* return addresses on the stack: a word inside a loaded image whose preceding bytes are a call instruction */
+        const ULONG_PTR *w = (const ULONG_PTR *)__builtin_frame_address(0);
+        const ULONG_PTR *top = *(const ULONG_PTR *const *)(shz_teb() + 8);      /* TEB.StackBase */
+        unsigned shown = 0;
+        for (; w + 1 < top && w < (const ULONG_PTR *)__builtin_frame_address(0) + 2048 && shown < 24; ++w) {
+            const unsigned char *pc = (const unsigned char *)*w;
+            PVOID b = 0;
+            if ((ULONG_PTR)pc < 0x10000 || !RtlPcToFileHeader((PVOID)pc, &b) || !b) continue;
+            if ((ULONG_PTR)pc < (ULONG_PTR)b + 0x1000 + 8) continue;          /* the headers: no code, and pc[-6] must stay inside the image */
+            if (!(pc[-5] == 0xe8 || (pc[-6] == 0xff && pc[-5] == 0x15) || (pc[-2] == 0xff && (pc[-1] & 0xf8) == 0xd0) ||
+                  (pc[-3] == 0x41 && pc[-2] == 0xff && (pc[-1] & 0xf8) == 0xd0))) continue;
+            n = 0;
+            n = put(line, n, sizeof line, "K32 trace: exit stack image=0x");
+            n = put_hex(line, n, sizeof line, (ULONG_PTR)b);
+            n = put(line, n, sizeof line, " rva=0x");
+            n = put_hex(line, n, sizeof line, (ULONG_PTR)pc - (ULONG_PTR)b);
+            line[n++] = '\n';
+            NtShzDebugPrint(line, n);
+            ++shown;
+        }
+    }
+}
+
+/* "K32 trace: <fn> failed: <path> error=0x<e> flags/access=0x<x>", at most 200 lines per process: the wide path is printed as ASCII
+ * ('?' above 0x7e). Used for CreateFileW, CreateNamedPipeW and CreateProcessW, where a Node/libuv failure usually names a path. */
+void k32_trace_failed_path(const char *fn, const WCHAR *path, DWORD error, ULONG_PTR extra)
+{
+    static volatile LONG lines;
+    char line[300];
+    unsigned n = 0, i;
+    const DWORD saved = GetLastError();                   /* k32_trace_on() reads the environment, which sets ERROR_ENVVAR_NOT_FOUND */
+    if (!k32_trace_on() || lines >= 200) { SetLastError(saved); return; }
+    InterlockedIncrement(&lines);
+    n = put(line, n, sizeof line, "K32 trace: ");
+    n = put(line, n, sizeof line, fn);
+    n = put(line, n, sizeof line, " failed: ");
+    for (i = 0; path && path[i] && i < 160 && n + 1 < sizeof line; ++i) line[n++] = path[i] < 0x7f && path[i] >= 0x20 ? (char)path[i] : '?';
+    n = put(line, n, sizeof line, " error=0x");
+    n = put_hex(line, n, sizeof line, error);
+    n = put(line, n, sizeof line, " extra=0x");
+    n = put_hex(line, n, sizeof line, extra);
+    line[n++] = '\n';
+    NtShzDebugPrint(line, n);
+    SetLastError(saved);
+}
