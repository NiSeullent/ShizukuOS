LIBRARY NTW32.DLL
EXPORTS
    InitializeSRWLock=NtwInitializeSRWLock@4
    AcquireSRWLockExclusive=NtwAcquireSRWLockExclusive@4
    AcquireSRWLockShared=NtwAcquireSRWLockShared@4
    ReleaseSRWLockExclusive=NtwReleaseSRWLockExclusive@4
    ReleaseSRWLockShared=NtwReleaseSRWLockShared@4
    TryAcquireSRWLockExclusive=NtwTryAcquireSRWLockExclusive@4
    TryAcquireSRWLockShared=NtwTryAcquireSRWLockShared@4
    GetTickCount64=NtwGetTickCount64@0
    GetProcAddress=NtwGetProcAddress@8
    InitOnceInitialize=NtwInitOnceInitialize@4
    InitOnceBeginInitialize=NtwInitOnceBeginInitialize@16
    InitOnceComplete=NtwInitOnceComplete@12
    InitOnceExecuteOnce=NtwInitOnceExecuteOnce@16
    MultiByteToWideChar=NtwMultiByteToWideChar@24
    WideCharToMultiByte=NtwWideCharToMultiByte@32
