+/* Existing regular-file replacement keeps the target alias/case/LFN slots.
+ * At most 20 source LFN slots plus its SFN span three sectors; the target SFN
+ * adds at most one. Beforeimages are collected before any namespace write.
+ * Source SFN removal precedes target publication even in the same sector:
+ * a write callback can modify only part of a sector before reporting failure.
+ * This is recoverable-I/O undo, NOT a journal or a power-loss/flush guarantee.
+ */
+struct replace_page {
+    uint64_t lba;
+    uint8_t before[FAT32_SECTOR], after[FAT32_SECTOR];
+    unsigned changed;
+};
+struct replace_undo {
+    struct replace_page pages[4];
+    unsigned count, source_page, source_offset, destination_page;
+};
+static int replace_page_get(fat32_vol_t *v, struct replace_undo *u, uint64_t lba)
+{
+    unsigned i;
+    int rc;
+    for (i = 0; i < u->count; ++i) if (u->pages[i].lba == lba) return (int)i;
+    if (u->count == 4) return FAT32_E_CORRUPT;
+    if ((rc = read_sector(v, lba, u->pages[i].before))) return rc;
+    f32_copy(u->pages[i].after, u->pages[i].before, FAT32_SECTOR);
+    u->pages[i].lba = lba;
+    ++u->count;
+    return (int)i;
+}
+/* Same checksum ownership rule as erase_entry, with no writes during the walk. */
+static int replace_collect_source(fat32_vol_t *v, struct replace_undo *u, uint32_t dir_first,
+                                  uint32_t dir_cluster, uint32_t dir_offset, const uint8_t source[32])
+{
+    uint32_t lc[20], lo[20], cl = dir_first ? dir_first : v->root_cluster, off = 0, guard = 0;
+    unsigned nl = 0, i;
+    const uint8_t sum = short_checksum(source);
+    int rc;
+    for (;;) {
+        const uint8_t *e;
+        if (!valid_cluster(v, cl) || ++guard > 65536 * 32) return FAT32_E_CORRUPT;
+        if (off >= v->bytes_per_cluster) {
+            const uint32_t next = fat32_fat_entry(v, cl);
+            if (next >= EOC) return FAT32_E_CORRUPT;
+            cl = next; off = 0; continue;
+        }
+        if ((rc = bounce(v, fat32_cluster_lba(v, cl) + off / FAT32_SECTOR))) return rc;
+        e = v->sector + off % FAT32_SECTOR;
+        if (!e[0]) return FAT32_E_CORRUPT;
+        if (cl == dir_cluster && off == dir_offset) {
+            for (i = 0; i < 32; ++i) if (e[i] != source[i]) return FAT32_E_CORRUPT;
+            break;
+        }
+        if (e[0] != 0xe5 && (e[11] & 0x3f) == FAT32_ATTR_LFN) {
+            if (e[0] & 0x40) nl = 0;
+            if (nl < 20) { lc[nl] = cl; lo[nl++] = off; }
+        } else nl = 0;
+        off += 32;
+    }
+    for (i = 0; i <= nl; ++i) {
+        const uint32_t c = i < nl ? lc[i] : dir_cluster, o = i < nl ? lo[i] : dir_offset;
+        int page = replace_page_get(v, u, fat32_cluster_lba(v, c) + o / FAT32_SECTOR);
+        uint8_t *e;
+        if (page < 0) return page;
+        e = u->pages[page].after + o % FAT32_SECTOR;
+        if (i < nl && e[13] != sum) continue;
+        e[0] = 0xe5;
+        u->pages[page].changed = 1;
+        if (i == nl) { u->source_page = (unsigned)page; u->source_offset = o % FAT32_SECTOR; }
+    }
+    return FAT32_OK;
+}
+static void replace_chain_values(fat32_vol_t *v, const fat32_chain_t *c, uint32_t last_value, int release)
+{
+    uint32_t i, j;
+    for (i = 0; i < c->nruns; ++i) {
+        const fat32_run_t *r = &c->runs[i];
+        for (j = 0; j < r->count; ++j) {
+            const uint32_t next = j + 1 < r->count ? r->start + j + 1 :
+                                  i + 1 < c->nruns ? c->runs[i + 1].start : last_value;
+            fat_set(v, r->start + j, release ? 0 : next);
+        }
+    }
+}
+static int replace_file(fat32_vol_t *v, uint32_t src_dir, uint32_t src_cluster, uint32_t src_offset,
