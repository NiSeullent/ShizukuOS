+        uint8_t *e = p->after + destination.dir_offset % FAT32_SECTOR;
+        /* SFN11, NTRes/case12 and LFN checksum/name stay the destination's. */
+        e[11] = source[11]; f32_copy(e + 13, source + 13, 19);
+        published = 1; /* even a failed callback may have changed this sector */
+        if ((rc = write_sector(v, p->lba, p->after))) goto undo;
+    }
+    freed = 1;
+    replace_chain_values(v, &old_chain, old_last, 1);
+    if ((rc = fat32_sync(v))) goto undo;
+    *out = destination;
+    out->attr = source[11]; out->first_cluster = source_first; out->size = rd32(source + 28);
+    out->ctenth = source[13]; out->ctime = rd16(source + 14); out->cdate = rd16(source + 16); out->adate = rd16(source + 18);
+    out->mtime = rd16(source + 22); out->mdate = rd16(source + 24);
+    rc = FAT32_OK;
+    goto done;
+undo:
+    /* Restore every old FAT value into ALL copies before reviving its name.
+     * fat_set preserves reserved bits and reverses free_clusters; allocation
+     * never occurs here, so alloc_hint is unchanged. Every affected sector is
+     * dirty again even if the failed sync had already cleared its dirty bit. */
+    if (freed) {
+        replace_chain_values(v, &old_chain, old_last, 0);
+        if (fat32_sync(v)) goto poison;
+    }
+    if (published) {
+        const struct replace_page *p = &u->pages[u->destination_page];
+        f32_copy(restore, p->before, FAT32_SECTOR);
+        /* Target undo must not resurrect source while target may still
+         * reference it; especially important with same-sector partial I/O. */
+        if (u->destination_page == u->source_page) restore[u->source_offset] = 0xe5;
+        if (write_sector(v, p->lba, restore)) goto poison;
+    }
+    for (i = 0; i < u->count; ++i) if (u->pages[i].changed)
+        if (write_sector(v, u->pages[i].lba, u->pages[i].before)) goto poison;
+    v->sector_lba = ~0ull;
+    goto done;
+poison:
+    /* Persistent/torn recovery is not an atomic-save guarantee. Do not let
+     * caller temp deletion or another mutation free an uncertain live chain.
+     * A fresh read-only inspection/recovery is required before write remount.
+     * Keep the original I/O error; never report a successful rollback. */
+    v->write = 0; v->sector_lba = ~0ull;
+done:
