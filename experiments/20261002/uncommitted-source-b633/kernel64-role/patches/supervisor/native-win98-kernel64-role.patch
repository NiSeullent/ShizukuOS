+def unique_json_object(pairs):
+    result = {}
+    for name, value in pairs:
+        if name in result:
+            raise ValueError("duplicate kernel build receipt key")
+        result[name] = value
+    return result
+
+
+def validate_kernel64_role(kernel, receipt_path, expected):
+    """Bind an explicit Kernel64 input to the producer's Supervisor role.
+
+    A caller-pinned ordinary build receipt is provenance, not a signature or
+    proof that this kernel boots or serves a native Windows98 peer.
+    """
+    receipt_path, expected = safe_path(receipt_path), pin_format(expected)
+    maximum = 1 << 20
+    size = pinned_hash(receipt_path, expected, maximum=maximum)
+    with read_leased(receipt_path, expected, size, maximum=maximum) as (fd, checkpoint):
+        with os.fdopen(os.dup(fd), "rb") as stream:
+            document = json.loads(stream.read(maximum + 1), object_pairs_hook=unique_json_object)
+        checkpoint()
+    kernels = document.get("kernels") if isinstance(document, dict) else None
+    role = kernels.get("kernel64") if isinstance(kernels, dict) else None
+    if not isinstance(role, dict):
+        raise ValueError("kernel build receipt lacks the Supervisor kernel64 role")
+    digest, extent = role.get("sha256"), role.get("bytes")
+    if not isinstance(digest, str) or not re.fullmatch("[0-9a-f]{64}", digest) or \
+       type(extent) is not int or not 0 < extent <= 16 << 20:
+        raise ValueError("invalid Supervisor kernel64 receipt SHA/size")
+    if digest != kernel["sha256"] or extent != kernel["bytes"]:
+        raise ValueError("Kernel64 input differs from the Supervisor kernel64 build role")
+    return {"path": receipt_path, "sha256": expected, "bytes": size,
+            "kernel64": {"sha256": digest, "bytes": extent}}
+
