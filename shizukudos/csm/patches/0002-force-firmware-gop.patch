+/* Strict checks used only by the explicit firmware GOP profile. */
+static bool shzgop_mask_linear(uint32_t mask)
+{
+    if (mask == 0)
+        return true;
+    mask >>= __builtin_ctz(mask);
+    return (mask & (mask + 1U)) == 0;
+}
+
+static bool shzgop_mode_usable(EFI_GRAPHICS_OUTPUT_PROTOCOL *gop)
+{
+    if (!gop || !gop->Mode || !gop->Mode->Info)
+        return false;
+    EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *info = gop->Mode->Info;
+    if (!gop->Mode->FrameBufferBase || !gop->Mode->FrameBufferSize
+     || gop->Mode->FrameBufferBase > UINT64_MAX - gop->Mode->FrameBufferSize
+     || !info->HorizontalResolution || !info->VerticalResolution
+     || info->PixelsPerScanLine < info->HorizontalResolution)
+        return false;
+
+    uint32_t bpp;
+    if (info->PixelFormat == PixelRedGreenBlueReserved8BitPerColor
+     || info->PixelFormat == PixelBlueGreenRedReserved8BitPerColor) {
+        bpp = 32;
+    } else if (info->PixelFormat == PixelBitMask) {
+        uint32_t r = info->PixelInformation.RedMask;
+        uint32_t g = info->PixelInformation.GreenMask;
+        uint32_t b = info->PixelInformation.BlueMask;
+        uint32_t a = info->PixelInformation.ReservedMask;
+        if (!r || !g || !b || (r & g) || (r & b) || (g & b)
+         || ((r | g | b) & a) || !shzgop_mask_linear(r)
+         || !shzgop_mask_linear(g) || !shzgop_mask_linear(b)
+         || !shzgop_mask_linear(a))
+            return false;
+        bpp = linear_masks_to_bpp(r, g, b, a);
+    } else {
+        return false; /* PixelBltOnly has no directly usable framebuffer. */
+    }
+    if (bpp != 8 && bpp != 16 && bpp != 24 && bpp != 32)
+        return false;
+    uint64_t pitch = (uint64_t)info->PixelsPerScanLine * (bpp / 8);
+    if (pitch > UINT32_MAX)
+        return false;
+    uint64_t visible = pitch * info->VerticalResolution;
+    return visible <= gop->Mode->FrameBufferSize;
+}
