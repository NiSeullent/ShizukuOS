+/* SPDX-License-Identifier: LGPL-2.1-only
+ * Shizuku fixed framebuffer handover. Wire fields are little-endian,
+ * pointer-free and packed; consumers must validate both coreboot checksums
+ * and this descriptor before mapping physical framebuffer memory.
+ */
+#ifndef SHZGOP_H
+#define SHZGOP_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define SHZGOP_CB_TAG 0x53485a47U
+#define SHZGOP_LINEAR 1U
+#define SHZGOP_FIXED_MODE 2U
+#define SHZGOP_PCI_VALID 4U
+#define SHZGOP_LOCATOR_BASE 0x000f0000U
+#define SHZGOP_LOCATOR_END 0x00100000U
+#define SHZGOP_LOCATOR_ALIGN 16U
+#define SHZGOP_LOCATOR_FSEG 1U
+
+struct shzgop_handover {
+    uint8_t magic[8];             /* "SHZGOP1\0" */
+    uint16_t major;
+    uint16_t minor;
+    uint32_t size;
+    uint32_t checksum;            /* sum of all LE u32 words is zero */
+    uint32_t flags;
+    uint64_t framebuffer_base;    /* final, after PCI BAR relocation */
+    uint64_t framebuffer_size;    /* actual GOP Mode->FrameBufferSize */
+    uint64_t visible_bytes;       /* pitch * height, <= framebuffer_size */
+    uint32_t width;
+    uint32_t height;
+    uint32_t pitch;
+    uint32_t bits_per_pixel;
+    uint32_t red_mask;
+    uint32_t green_mask;
+    uint32_t blue_mask;
+    uint32_t reserved_mask;
+    uint16_t pci_segment;
+    uint8_t pci_bus;
+    uint8_t pci_devfn;
+    uint16_t pci_vendor;
+    uint16_t pci_device;
+    uint32_t firmware_mode;
+    uint32_t reserved;
+} __attribute__((packed));
+
+struct shzgop_cb_record {
+    uint32_t tag;
+    uint32_t size;
+    uint64_t descriptor_address;
+    uint32_t descriptor_size;
+    uint32_t reserved;
+} __attribute__((packed));
+
+/* Allocated by SeaBIOS Legacy16GetTableAddress, F000-only, aligned 16.
+ * Consumers scan only complete aligned slots in the F-segment. */
+struct shzgop_locator {
+    uint8_t magic[8];             /* "SHZLOC1\0" */
+    uint16_t major;
+    uint16_t minor;
+    uint32_t size;
+    uint32_t checksum;            /* sum of all 12 LE u32 words is zero */
+    uint32_t self_address;        /* binds the anchor to its allocated slot */
+    uint64_t descriptor_address;
+    uint32_t descriptor_size;
+    uint32_t descriptor_checksum; /* final SHZGOP1 checksum at offset 16 */
+    uint32_t flags;               /* SHZGOP_LOCATOR_FSEG */
+    uint32_t reserved;
+} __attribute__((packed));
+
+_Static_assert(sizeof(struct shzgop_handover) == 96, "SHZGOP1 wire size");
+_Static_assert(offsetof(struct shzgop_handover, framebuffer_base) == 24, "SHZGOP1 framebuffer offset");
+_Static_assert(offsetof(struct shzgop_handover, pci_segment) == 80, "SHZGOP1 PCI offset");
+_Static_assert(sizeof(struct shzgop_cb_record) == 24, "SHZGOP1 coreboot record size");
+_Static_assert(sizeof(struct shzgop_locator) == 48, "SHZLOC1 wire size");
+_Static_assert(offsetof(struct shzgop_locator, self_address) == 20, "SHZLOC1 slot offset");
+_Static_assert(offsetof(struct shzgop_locator, descriptor_address) == 24, "SHZLOC1 descriptor offset");
+#endif
