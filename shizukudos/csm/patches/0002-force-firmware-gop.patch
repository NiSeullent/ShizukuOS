+/* Allocate a page that remains E820-reserved after ExitBootServices.
+ * Snapshot GOP values now: no GOP protocol or mode structure may be used
+ * after ExitBootServices. The final physical base is filled after PCI init.
+ */
+static void shzgop_prepare_handover(struct csmwrap_priv *priv)
+{
+    EFI_PHYSICAL_ADDRESS page = 0xffffffffULL;
+    if (gBS->AllocatePages(AllocateMaxAddress, EfiRuntimeServicesData, 1, &page) != EFI_SUCCESS
+     || page <= 0x100000 || page > 0x100000000ULL - EFI_PAGE_SIZE)
+        panic("gop_only: unable to reserve a handover page below 4GiB\n");
+    memset((void *)(uintptr_t)page, 0, EFI_PAGE_SIZE);
+    struct shzgop_handover *fb = (void *)(uintptr_t)page;
+    priv->gop_handover = fb;
+    memcpy(fb->magic, "SHZGOP1", 8);
+    fb->major = 1;
+    fb->size = sizeof(*fb);
+    fb->flags = SHZGOP_LINEAR | SHZGOP_FIXED_MODE;
+    fb->framebuffer_size = priv->gop->Mode->FrameBufferSize;
+    fb->visible_bytes = (uint64_t)priv->cb_fb.bytes_per_line * priv->cb_fb.y_resolution;
+    fb->width = priv->cb_fb.x_resolution;
+    fb->height = priv->cb_fb.y_resolution;
+    fb->pitch = priv->cb_fb.bytes_per_line;
+    fb->bits_per_pixel = priv->cb_fb.bits_per_pixel;
+    fb->red_mask = ((1ULL << priv->cb_fb.red_mask_size) - 1) << priv->cb_fb.red_mask_pos;
+    fb->green_mask = ((1ULL << priv->cb_fb.green_mask_size) - 1) << priv->cb_fb.green_mask_pos;
+    fb->blue_mask = ((1ULL << priv->cb_fb.blue_mask_size) - 1) << priv->cb_fb.blue_mask_pos;
+    fb->reserved_mask = ((1ULL << priv->cb_fb.reserved_mask_size) - 1) << priv->cb_fb.reserved_mask_pos;
+    fb->firmware_mode = priv->gop->Mode->Mode;
+
+    /* PCI metadata is optional; its validity flag is set only on success. */
+    if (FindVgaPciInfo(priv) == EFI_SUCCESS && priv->vga_pci_io) {
+        UINTN segment, bus, device, function;
+        UINT16 vendor, device_id;
+        EFI_PCI_IO_PROTOCOL *pci = priv->vga_pci_io;
+        if (pci->GetLocation(pci, &segment, &bus, &device, &function) == EFI_SUCCESS
+         && segment <= UINT16_MAX && bus <= UINT8_MAX && device <= 31 && function <= 7
+         && pci->Pci.Read(pci, EfiPciIoWidthUint16, 0, 1, &vendor) == EFI_SUCCESS
+         && pci->Pci.Read(pci, EfiPciIoWidthUint16, 2, 1, &device_id) == EFI_SUCCESS
+         && vendor != 0xffff && vendor != 0) {
+            fb->pci_segment = segment;
+            fb->pci_bus = bus;
+            fb->pci_devfn = (device << 3) | function;
+            fb->pci_vendor = vendor;
+            fb->pci_device = device_id;
+            fb->flags |= SHZGOP_PCI_VALID;
+        }
+    }
+}
