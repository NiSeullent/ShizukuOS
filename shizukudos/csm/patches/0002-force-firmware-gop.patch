+static uint32_t shzgop_wire_sum(const void *data, size_t size)
+{
+    uint32_t sum = 0;
+    for (size_t i = 0; i < size; i += sizeof(uint32_t)) {
+        uint32_t word;
+        memcpy(&word, (const uint8_t *)data + i, sizeof(word));
+        sum += word;
+    }
+    return sum;
+}
