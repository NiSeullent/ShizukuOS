+static void shzgop_verify_locator(struct csmwrap_priv *priv)
+{
+    struct shzgop_locator *anchor = priv->gop_locator;
+    struct shzgop_handover *fb = priv->gop_handover;
+    uintptr_t address = (uintptr_t)anchor;
+    if (!anchor || !fb || address < SHZGOP_LOCATOR_BASE
+     || address > SHZGOP_LOCATOR_END - sizeof(*anchor)
+     || (address & (SHZGOP_LOCATOR_ALIGN - 1))
+     || memcmp(anchor->magic, "SHZLOC1", 8) || anchor->major != 1
+     || anchor->minor != 0 || anchor->size != sizeof(*anchor)
+     || anchor->self_address != address || anchor->flags != SHZGOP_LOCATOR_FSEG
+     || anchor->reserved || anchor->descriptor_address != (uintptr_t)fb
+     || anchor->descriptor_size != sizeof(*fb)
+     || anchor->descriptor_checksum != fb->checksum
+     || shzgop_wire_sum(anchor, sizeof(*anchor))
+     || shzgop_wire_sum(fb, sizeof(*fb)))
+        panic("gop_only: invalid persistent F-segment locator\n");
+}
+
+/* AX=6 is the pinned SeaBIOS CSM F-segment allocator, not a guessed ROM hole.
+ * It runs only after InitializeYourself and before PrepareToBoot, whose BIOS
+ * checksum includes our allocated bytes. PCI relocation/descriptor finalizing
+ * has already completed, so the anchor binds the final descriptor checksum. */
+static void shzgop_publish_locator(struct csmwrap_priv *priv)
+{
+    EFI_IA32_REGISTER_SET regs;
+    struct shzgop_handover *fb = priv->gop_handover;
+    uintptr_t descriptor_address = (uintptr_t)fb;
+    if (!fb || descriptor_address <= 0x100000U
+     || descriptor_address > 0xfffff000U || (descriptor_address & 4095U)
+     || memcmp(fb->magic, "SHZGOP1", 8) || fb->major != 1 || fb->minor != 0
+     || fb->size != sizeof(*fb) || shzgop_wire_sum(fb, sizeof(*fb)))
+        panic("gop_only: descriptor is not finalized before locator allocation\n");
+    memset(&regs, 0, sizeof(regs));
+    regs.X.AX = Legacy16GetTableAddress;
+    regs.X.BX = 1; /* F000 region only; no E000/low-memory fallback. */
+    regs.X.CX = sizeof(struct shzgop_locator);
+    regs.X.DX = SHZGOP_LOCATOR_ALIGN;
+    bool failed = LegacyBiosFarCall86(priv->csm_efi_table->Compatibility16CallSegment,
+                                     priv->csm_efi_table->Compatibility16CallOffset,
+                                     &regs, NULL, 0);
+    uintptr_t address = ((uintptr_t)regs.X.DS << 4) + regs.X.BX;
+    if (failed || regs.X.AX || address < SHZGOP_LOCATOR_BASE
+     || address > SHZGOP_LOCATOR_END - sizeof(struct shzgop_locator)
+     || (address & (SHZGOP_LOCATOR_ALIGN - 1)))
+        panic("gop_only: SeaBIOS F-segment locator allocation failed\n");
+    struct shzgop_locator *anchor = (void *)address;
+    memset(anchor, 0, sizeof(*anchor));
+    memcpy(anchor->magic, "SHZLOC1", 8);
+    anchor->major = 1;
+    anchor->size = sizeof(*anchor);
+    anchor->self_address = address;
+    anchor->descriptor_address = descriptor_address;
+    anchor->descriptor_size = sizeof(*fb);
+    anchor->descriptor_checksum = fb->checksum;
+    anchor->flags = SHZGOP_LOCATOR_FSEG;
+    anchor->checksum = 0U - shzgop_wire_sum(anchor, sizeof(*anchor));
+    priv->gop_locator = anchor;
+    asm volatile ("" ::: "memory"); /* Require actual F-segment readback. */
+    shzgop_verify_locator(priv);
+    printf("SHZLOC1 anchor=0x%x descriptor=0x%x checksum=0x%x\n",
+           anchor->self_address, (uint32_t)descriptor_address, fb->checksum);
+}
