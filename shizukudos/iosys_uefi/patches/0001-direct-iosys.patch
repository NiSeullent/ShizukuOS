+/* SPDX-License-Identifier: LGPL-2.1-only */
+#ifndef SHIZUKU_IOSYS_UEFI_H
+#define SHIZUKU_IOSYS_UEFI_H
+#include <efi.h>
+struct csmwrap_priv;
+/* All filesystem/BlockIO work ends before ExitBootServices. */
+void iosys_uefi_prepare(EFI_FILE_PROTOCOL *root, EFI_HANDLE boot_device);
+/* Read only the finalized reserved handover, never an EFI GOP protocol. */
+void iosys_uefi_snapshot(struct csmwrap_priv *priv);
