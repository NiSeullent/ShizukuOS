+/* Source-written MS-DOS7 registry pathname contract; no implicit default.
+   These buffers are resident kernel data, not reclaimed initialization data. */
+#define WIN_REGISTRY_MAX 78
+STATIC BYTE winRegistryPath[WIN_REGISTRY_MAX + 1];
+
+STATIC BOOL winRegistryPathValid(const BYTE *path, UWORD length)
+{
+  UWORD i, base = 0, extension = 0;
+  BOOL dot = FALSE;
+  if (length < 4 ||
+      !((path[0] >= 'A' && path[0] <= 'Z') ||
+        (path[0] >= 'a' && path[0] <= 'z')) ||
+      path[1] != ':' || path[2] != '\\')
+    return FALSE;
+  for (i = 3; i < length; ++i)
+  {
+    BYTE c = path[i];
+    if (c == '\\')
+    {
+      if (!base || (dot && !extension)) return FALSE;
+      base = extension = 0; dot = FALSE;
+    }
+    else if (c == '.')
+    {
+      if (!base || dot) return FALSE;
+      dot = TRUE;
+    }
+    else
+    {
+      if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+            (c >= '0' && c <= '9') || c == '_' || c == '-'))
+        return FALSE;
+      if (dot) { if (++extension > 3) return FALSE; }
+      else { if (++base > 8) return FALSE; }
+    }
+  }
+  return base && (!dot || extension);
+}
+
+STATIC UWORD winRegistrySet(const BYTE FAR *source)
+{
+  BYTE staged[WIN_REGISTRY_MAX + 1];
+  UWORD i;
+  for (i = 0; i <= WIN_REGISTRY_MAX; ++i)
+  {
+    if ((ULONG)FP_OFF(source) + i > 0xfffful) return WIN_REGISTRY_MAX;
+    staged[i] = source[i];
+    if (!staged[i]) break;
+  }
+  if (i > WIN_REGISTRY_MAX || !winRegistryPathValid(staged, i))
+    return WIN_REGISTRY_MAX;
+  /* Validate completely before changing the resident state. */
+  memcpy(winRegistryPath, staged, i + 1);
+  return 0;
+}
+
+STATIC UWORD winRegistryGet(BYTE FAR *destination, UWORD capacity)
+{
+  UWORD length;
+  if (!winRegistryPath[0]) return 0x1613;
+  length = strlen(winRegistryPath) + 1;
+  if (capacity < length || (ULONG)FP_OFF(destination) + length > 0x10000ul)
+    return WIN_REGISTRY_MAX;
+  fmemcpy(destination, winRegistryPath, length);
+  /* The actual original DOS query preserves caller CX (observed capacity80). */
+  return 0;
+}
