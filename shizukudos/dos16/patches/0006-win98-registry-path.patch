+STATIC VOID CfgWinReg(BYTE * pLine)
+{
+  iregs r;
+  BYTE *tail = GetStringArg(pLine, szBuf);
+  tail = skipwh(tail);
+  if (*tail && *tail != '\r' && *tail != '\n')
+  {
+    CfgFailure(pLine);
+    return;
+  }
+  memset(&r, 0, sizeof(r));
+  r.a.x = 0x1614;
+  r.es = FP_SEG((BYTE FAR *)szBuf);
+  r.di = FP_OFF((BYTE FAR *)szBuf);
+  init_call_intr(0x2f, &r);
+  if (r.a.x != 0) CfgFailure(pLine);
+}
