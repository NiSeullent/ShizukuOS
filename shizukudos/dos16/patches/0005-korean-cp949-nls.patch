 COUNT DosSetCodepage(UWORD actCP, UWORD sysCP)
 {
+  struct nlsPackage FAR *nls;
+  /* Only fully resident packages can establish a new system CP. Unsupported
+     pages leave both the package and system CP untouched. WIN.COM uses BX=DX. */
+  if (actCP == sysCP && (actCP == 437 || actCP == 949))
+  {
+    nls = searchPackage(actCP, actCP == 949 ? 82 : 1);
+    if (nls == NULL) return DE_INVLDDATA;
+    nlsLoadPackage(nls);
+    nlsInfo.sysCodePage = sysCP;
+    return SUCCESS;
+  }
   if (sysCP == NLS_DEFAULT || sysCP == nlsInfo.sysCodePage)
     return DosSetPackage(actCP, NLS_DEFAULT);
   return DE_INVLDDATA;
