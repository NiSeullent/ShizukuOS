+/* Preserve complete DBCS pairs, including ASCII-looking trail bytes. */
+STATIC BOOL nlsLeadByte(struct nlsPackage FAR * nls, UBYTE ch)
+{
+  UWORD FAR *t = ((struct nlsDBCS FAR *)getTable7(nls))->dbcsTbl;
+  if (ch < 128) return FALSE;
+  for (; *t; ++t)
+    if (ch >= (*t & 0xff) && ch <= (*t >> 8)) return TRUE;
+  return FALSE;
+}
+STATIC void nlsCaseMem(struct nlsPackage FAR *nls, UBYTE FAR *table,
+                      UBYTE FAR *str, unsigned len)
+{
+  while (len)
+  {
+    if (nlsLeadByte(nls, *str))
+    {
+      unsigned span = len > 1 ? 2 : 1;
+      str += span; len -= span;
+    }
+    else { upMMem(table, str, 1); ++str; --len; }
+  }
+}
 STATIC void nlsUpMem(struct nlsPackage FAR * nls, VOID FAR * str, int len)
 {
   log(("NLS: nlsUpMem()\n"));
-  upMMem(getCharTbl2(nls), (UBYTE FAR *) str, len);
+  nlsCaseMem(nls, getCharTbl2(nls), (UBYTE FAR *)str, len);
 }
