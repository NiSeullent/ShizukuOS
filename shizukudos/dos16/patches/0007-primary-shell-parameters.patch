+/* The actual CONFIG/default primary-shell EXEC arguments survive init reclaim
+   and SecPathName reuse.  Nothing is published until its LOADNGO transfer. */
+STATIC BYTE winShellName[NAMEMAX];
+STATIC CommandTail winShellTail;
+STATIC UWORD winShellOwner, winShellPsp;
+STATIC BOOL winShellPending, winShellPublished;
+
+VOID winShellReset(VOID)
+{
+  winShellPublished = FALSE;
+  winShellPending = FALSE;
+  winShellOwner = winShellPsp = 0;
+}
+
+VOID winShellStage(const BYTE FAR *name, const CommandTail FAR *tail, UWORD owner)
+{
+  UWORD length, count, i;
+  winShellReset();
+  if (!owner) return;
+  for (length = 0; length < NAMEMAX; ++length)
+  {
+    if ((ULONG)FP_OFF(name) + length > 0xfffful) return;
+    if (!name[length]) break;
+    if ((UBYTE)name[length] < 0x20) return;
+  }
+  if (!length || length == NAMEMAX) return;
+  count = tail->ctCount;
+  if (count >= CTBUFFERSIZE ||
+      (ULONG)FP_OFF(tail) + count + 2 > 0x10000ul ||
+      tail->ctBuffer[count] != '\r') return;
+  /* Both resident buffers use DGROUP; DS is common to the returned pointers. */
+  fmemcpy(winShellName, name, length + 1);
+  memset(&winShellTail, 0, sizeof(winShellTail));
+  winShellTail.ctCount = count;
+  for (i = 0; i <= count; ++i) winShellTail.ctBuffer[i] = tail->ctBuffer[i];
+  winShellOwner = owner;
+  winShellPending = TRUE;
+}
+
+VOID winShellCommit(UWORD parent, UWORD process)
+{
+  if (winShellPending && parent == winShellOwner && process && process != parent)
+  {
+    winShellPsp = process;
+    winShellPublished = TRUE;
+    winShellPending = FALSE;
+  }
+}
+
+VOID winShellProcessEnd(UWORD process)
+{
+  if (winShellPublished && winShellPsp == process) winShellReset();
+}
 
