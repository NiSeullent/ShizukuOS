@ECHO OFF
SET PATH=C:\
SET COMSPEC=C:\COMMAND.COM
PROMPT SHZ$P$G
IF EXIST C:\SHZSAFE.TAG GOTO RECOVERY
IF NOT EXIST C:\SHZSTART.BAT GOTO RECOVERY
CALL C:\SHZSTART.BAT
IF ERRORLEVEL 1 GOTO RECOVERY
SET SHZPROFILE=NORMAL
C:\SHZREADY.COM N
GOTO END
:RECOVERY
SET SHZPROFILE=RECOVERY
PROMPT RECOVERY$P$G
ECHO ShizukuDOS 10 recovery shell.
ECHO Startup was skipped or failed. Type RECOVER for recovery help.
C:\SHZREADY.COM R
:END
