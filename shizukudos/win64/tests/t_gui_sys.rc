/* SPDX-License-Identifier: GPL-2.0-only
 * Resources of T_GUI_SYS (win64/tests/t_gui_sys.c): a string table, an 8x8 32 bpp icon (raw RT_ICON / RT_GROUP_ICON data:
 * top half red, bottom half blue), a menu, a dialog and an accelerator table. The icon words were produced once with
 * Python's struct module from the layout written above; they are data, not generated at build time. */
#include <windows.h>

STRINGTABLE
BEGIN
    101 "Hello resources"
    117 "Seventeen"
END

