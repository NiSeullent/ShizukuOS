300 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open\tCtrl+O", 301
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 302
    END
    MENUITEM "&Help", 303
END

400 DIALOGEX 10, 10, 160, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Resource Dialog"
BEGIN
    CONTROL "&Check me", 401, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 8, 100, 12
    LTEXT "A static label", 402, 8, 26, 120, 10
    DEFPUSHBUTTON "OK", IDOK, 20, 56, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 90, 56, 50, 14
END

500 ACCELERATORS
BEGIN
    "O", 501, VIRTKEY, CONTROL
    VK_F5, 502, VIRTKEY
END
