-NTSTATUS WINAPI SystemFunction040( void *memory, ULONG length, ULONG flags )
+/* Shizuku: RtlEncryptMemory/RtlDecryptMemory with three-key triple DES in CBC mode (8-byte blocks, as
+ * RTL_ENCRYPT_MEMORY_SIZE requires) and a zero IV, so equal plaintexts under one key encrypt equally, as on Windows.
+ *  - RTL_ENCRYPT_OPTION_SAME_PROCESS: a random key generated once per process;
+ *  - RTL_ENCRYPT_OPTION_CROSS_PROCESS / SAME_LOGON: one random key per boot, kept in the volatile registry
+ *    (HKLM\\System\\CurrentControlSet\\Control\\Shizuku\\MemoryProtection, value BootKey). Shizuku has a single
+ *    user, so SAME_LOGON is not bound to a logon session; any local process of this boot can decrypt. */
+#define MEMKEY_LEN 24
+#ifndef RTL_ENCRYPT_MEMORY_SIZE
+#define RTL_ENCRYPT_MEMORY_SIZE          8     /* ntsecapi.h (Windows SDK) */
+#define RTL_ENCRYPT_OPTION_CROSS_PROCESS 0x01
+#define RTL_ENCRYPT_OPTION_SAME_LOGON    0x02
+#endif
+static BYTE process_key[MEMKEY_LEN];
+static BOOL process_key_ready;
+
+static BOOL get_boot_key( BYTE *key )
 {
-    FIXME("(%p, %lu, %#lx): stub [RtlEncryptMemory]\n", memory, length, flags);
+    static const WCHAR path[] = L"System\\CurrentControlSet\\Control\\Shizuku\\MemoryProtection";
+    HKEY hkey;
+    DWORD disp, type, size = MEMKEY_LEN, tries;
+    LONG ret;
+
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, path, 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &hkey, &disp ))
+        return FALSE;
+    if (disp == REG_CREATED_NEW_KEY)
+    {
+        /* the creator of the key writes the value; everybody else waits for it */
+        if (!SystemFunction036( key, MEMKEY_LEN ) ||
+            RegSetValueExW( hkey, L"BootKey", 0, REG_BINARY, key, MEMKEY_LEN ))
+        {
+            RegCloseKey( hkey );
+            return FALSE;
+        }
+        RegCloseKey( hkey );
+        return TRUE;
+    }
+    for (tries = 0; tries < 1000; tries++)
+    {
+        size = MEMKEY_LEN;
+        ret = RegQueryValueExW( hkey, L"BootKey", NULL, &type, key, &size );
+        if (!ret && type == REG_BINARY && size == MEMKEY_LEN) break;
+        Sleep( 1 );
+    }
+    RegCloseKey( hkey );
+    return tries < 1000;
+}
+
+static NTSTATUS memory_crypt( BYTE *data, ULONG length, ULONG flags, BOOL encrypt )
+{
+    static BYTE boot_key[MEMKEY_LEN];
+    static BOOL boot_key_ready;
+    symmetric_key skey;
+    BYTE iv[8] = {0}, block[8], *key;
+    ULONG i, j;
+
+    if (length % RTL_ENCRYPT_MEMORY_SIZE) return STATUS_INVALID_PARAMETER;
+    if (flags & ~(RTL_ENCRYPT_OPTION_CROSS_PROCESS | RTL_ENCRYPT_OPTION_SAME_LOGON)) return STATUS_INVALID_PARAMETER;
+    if (!length) return STATUS_SUCCESS;
+
+    EnterCriticalSection( &random_cs );
+    if (flags)
+    {
+        if (!boot_key_ready && get_boot_key( boot_key )) boot_key_ready = TRUE;
+        key = boot_key_ready ? boot_key : NULL;
+    }
+    else
+    {
+        /* random_cs is recursive: SystemFunction036 may be called with it held */
+        if (!process_key_ready && SystemFunction036( process_key, MEMKEY_LEN )) process_key_ready = TRUE;
+        key = process_key_ready ? process_key : NULL;
+    }
+    if (!key || des3_setup( key, MEMKEY_LEN, 0, &skey ) != CRYPT_OK)
+    {
+        LeaveCriticalSection( &random_cs );
+        return STATUS_INTERNAL_ERROR;
+    }
+    LeaveCriticalSection( &random_cs );
+
+    for (i = 0; i < length; i += 8)
+    {
+        if (encrypt)
+        {
+            for (j = 0; j < 8; j++) block[j] = data[i + j] ^ iv[j];
+            des3_ecb_encrypt( block, data + i, &skey );
+            memcpy( iv, data + i, 8 );
+        }
+        else
+        {
+            memcpy( block, data + i, 8 );
+            des3_ecb_decrypt( block, data + i, &skey );
+            for (j = 0; j < 8; j++) data[i + j] ^= iv[j];
+            memcpy( iv, block, 8 );
+        }
+    }
+    des3_done( &skey );
+    SecureZeroMemory( &skey, sizeof(skey) );
     return STATUS_SUCCESS;
 }
 
+NTSTATUS WINAPI SystemFunction040( void *memory, ULONG length, ULONG flags )
+{
+    TRACE("(%p, %lu, %#lx)\n", memory, length, flags);
+    return memory_crypt( memory, length, flags, TRUE );
+}
