diff --git a/dlls/crypt32/chain.c b/dlls/crypt32/chain.c
index 1b38e78..7110d72 100644
--- a/dlls/crypt32/chain.c
+++ b/dlls/crypt32/chain.c
@@ -2964,12 +2964,182 @@ VOID WINAPI CertFreeCertificateChain(PCCERT_CHAIN_CONTEXT pChainContext)
     }
 }
 
+/* Shizuku: CertFindChainInStore(CERT_CHAIN_FIND_BY_ISSUER), written from the Windows SDK documentation (the
+ * parameter block and flags are not in Wine's wincrypt.h). For each certificate of the store after the previous chain's
+ * end certificate: unless NO_KEY is set, the certificate must have a private key (CERT_KEY_PROV_INFO_PROP_ID with the
+ * requested dwKeySpec, or a cached key context); with COMPARE_KEY the key is acquired and its public key must equal the
+ * certificate's. A chain is built (with the store as additional store, the usage identifier as requested usage and
+ * cache-only URL retrieval when asked); a chain not valid for the usage is skipped. With issuers given, some certificate
+ * of the first simple chain (of any simple chain with COMPLEX_CHAIN) must have one of them as issuer name. The optional
+ * callback has the last word. The previous chain context is always freed. */
+#ifndef CERT_CHAIN_FIND_BY_ISSUER_COMPARE_KEY_FLAG
+#define CERT_CHAIN_FIND_BY_ISSUER_COMPARE_KEY_FLAG    0x0001
+#define CERT_CHAIN_FIND_BY_ISSUER_COMPLEX_CHAIN_FLAG  0x0002
+#define CERT_CHAIN_FIND_BY_ISSUER_CACHE_ONLY_URL_FLAG 0x0004
+#define CERT_CHAIN_FIND_BY_ISSUER_LOCAL_MACHINE_FLAG  0x0008
+#define CERT_CHAIN_FIND_BY_ISSUER_NO_KEY_FLAG         0x4000
+#define CERT_CHAIN_FIND_BY_ISSUER_CACHE_ONLY_FLAG     0x8000
+typedef BOOL (WINAPI *PFN_CERT_CHAIN_FIND_BY_ISSUER_CALLBACK)(PCCERT_CONTEXT cert, void *arg);
+typedef struct _CERT_CHAIN_FIND_BY_ISSUER_PARA
+{
+    DWORD cbSize;
+    LPCSTR pszUsageIdentifier;
+    DWORD dwKeySpec;
+    DWORD dwAcquirePrivateKeyFlags;
+    DWORD cIssuer;
+    CERT_NAME_BLOB *rgIssuer;
+    PFN_CERT_CHAIN_FIND_BY_ISSUER_CALLBACK pfnFindCallback;
+    void *pvFindArg;
+    DWORD *pdwIssuerChainIndex;
+    DWORD *pdwIssuerElementIndex;
+} CERT_CHAIN_FIND_BY_ISSUER_PARA;
+#endif
+
+static BOOL find_chain_cert_has_key(PCCERT_CONTEXT cert, const CERT_CHAIN_FIND_BY_ISSUER_PARA *para, DWORD flags)
+{
+    CRYPT_KEY_PROV_INFO *info;
+    CERT_KEY_CONTEXT key_context;
+    DWORD size = 0;
+    BOOL ret;
+
+    if (CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, NULL, &size))
+    {
+        if (!(info = CryptMemAlloc(size))) return FALSE;
+        ret = CertGetCertificateContextProperty(cert, CERT_KEY_PROV_INFO_PROP_ID, info, &size) &&
+              (!para->dwKeySpec || info->dwKeySpec == para->dwKeySpec);
+        CryptMemFree(info);
+    }
+    else
+    {
+        size = sizeof(key_context);
+        ret = CertGetCertificateContextProperty(cert, CERT_KEY_CONTEXT_PROP_ID, &key_context, &size) &&
+              (!para->dwKeySpec || key_context.dwKeySpec == para->dwKeySpec);
+    }
+    if (ret && (flags & CERT_CHAIN_FIND_BY_ISSUER_COMPARE_KEY_FLAG))
+    {
+        HCRYPTPROV_OR_NCRYPT_KEY_HANDLE prov;
+        CERT_PUBLIC_KEY_INFO *pub;
+        DWORD spec;
+        BOOL free_prov;
+
+        ret = CryptAcquireCertificatePrivateKey(cert, para->dwAcquirePrivateKeyFlags & ~CRYPT_ACQUIRE_SILENT_FLAG, NULL,
+                                                &prov, &spec, &free_prov);
+        if (ret)
+        {
+            size = 0;
+            ret = CryptExportPublicKeyInfo(prov, spec, cert->dwCertEncodingType, NULL, &size) &&
+                  (pub = CryptMemAlloc(size));
+            if (ret)
+            {
+                ret = CryptExportPublicKeyInfo(prov, spec, cert->dwCertEncodingType, pub, &size) &&
+                      CertComparePublicKeyInfo(cert->dwCertEncodingType, &cert->pCertInfo->SubjectPublicKeyInfo, pub);
+                CryptMemFree(pub);
+            }
+            if (free_prov) CryptReleaseContext(prov, 0);
+        }
+    }
+    return ret;
+}
+
+static BOOL find_chain_issuer_match(PCCERT_CHAIN_CONTEXT chain, const CERT_CHAIN_FIND_BY_ISSUER_PARA *para, DWORD flags,
+                                    DWORD *chain_index, DWORD *element_index)
+{
+    DWORD i, j, k, chains;
+
+    if (!para->cIssuer)
+    {
+        *chain_index = *element_index = 0;
+        return TRUE;
+    }
+    chains = (flags & CERT_CHAIN_FIND_BY_ISSUER_COMPLEX_CHAIN_FLAG) ? chain->cChain : min(chain->cChain, 1);
+    for (i = 0; i < chains; i++)
+        for (j = 0; j < chain->rgpChain[i]->cElement; j++)
+        {
+            PCCERT_CONTEXT c = chain->rgpChain[i]->rgpElement[j]->pCertContext;
+            for (k = 0; k < para->cIssuer; k++)
+                if (CertCompareCertificateName(c->dwCertEncodingType, &c->pCertInfo->Issuer, &para->rgIssuer[k]))
+                {
+                    *chain_index = i;
+                    *element_index = j;
+                    return TRUE;
+                }
+        }
+    return FALSE;
+}
+
 PCCERT_CHAIN_CONTEXT WINAPI CertFindChainInStore(HCERTSTORE store,
  DWORD certEncodingType, DWORD findFlags, DWORD findType,
  const void *findPara, PCCERT_CHAIN_CONTEXT prevChainContext)
 {
-    FIXME("(%p, %08lx, %08lx, %ld, %p, %p): stub\n", store, certEncodingType,
+    const CERT_CHAIN_FIND_BY_ISSUER_PARA *para = findPara;
+    PCCERT_CONTEXT cert = NULL;
+    PCCERT_CHAIN_CONTEXT chain;
+    HCERTCHAINENGINE engine;
+    CERT_CHAIN_PARA chain_para;
+    DWORD chain_flags = 0;
+
+    TRACE("(%p, %08lx, %08lx, %ld, %p, %p)\n", store, certEncodingType,
      findFlags, findType, findPara, prevChainContext);
+
+    if (findType != CERT_CHAIN_FIND_BY_ISSUER || !para ||
+        para->cbSize < offsetof(CERT_CHAIN_FIND_BY_ISSUER_PARA, pdwIssuerChainIndex) ||
+        (para->cIssuer && !para->rgIssuer))
+    {
+        if (prevChainContext) CertFreeCertificateChain(prevChainContext);
+        SetLastError(E_INVALIDARG);
+        return NULL;
+    }
+    if (prevChainContext)
+    {
+        PCCERT_CONTEXT last = prevChainContext->rgpChain[0]->rgpElement[0]->pCertContext;
+
+        cert = CertFindCertificateInStore(store, last->dwCertEncodingType, 0, CERT_FIND_EXISTING, last, NULL);
+        CertFreeCertificateChain(prevChainContext);
+        if (!cert)
+        {
+            SetLastError(CRYPT_E_NOT_FOUND);
+            return NULL;
+        }
+    }
+    memset(&chain_para, 0, sizeof(chain_para));
+    chain_para.cbSize = sizeof(chain_para);
+    if (para->pszUsageIdentifier)
+    {
+        chain_para.RequestedUsage.dwType = USAGE_MATCH_TYPE_AND;
+        chain_para.RequestedUsage.Usage.cUsageIdentifier = 1;
+        chain_para.RequestedUsage.Usage.rgpszUsageIdentifier = (LPSTR *)&para->pszUsageIdentifier;
+    }
+    if (findFlags & (CERT_CHAIN_FIND_BY_ISSUER_CACHE_ONLY_URL_FLAG | CERT_CHAIN_FIND_BY_ISSUER_CACHE_ONLY_FLAG))
+        chain_flags |= CERT_CHAIN_CACHE_ONLY_URL_RETRIEVAL;
+    engine = (findFlags & CERT_CHAIN_FIND_BY_ISSUER_LOCAL_MACHINE_FLAG) ? HCCE_LOCAL_MACHINE : HCCE_CURRENT_USER;
+
+    while ((cert = CertEnumCertificatesInStore(store, cert)))
+    {
+        DWORD chain_index, element_index;
+
+        if (certEncodingType && GET_CERT_ENCODING_TYPE(certEncodingType) &&
+            !(GET_CERT_ENCODING_TYPE(cert->dwCertEncodingType) & GET_CERT_ENCODING_TYPE(certEncodingType)))
+            continue;
+        if (!(findFlags & CERT_CHAIN_FIND_BY_ISSUER_NO_KEY_FLAG) && !find_chain_cert_has_key(cert, para, findFlags))
+            continue;
+        if (!CertGetCertificateChain(engine, cert, NULL, store, &chain_para, chain_flags, NULL, &chain))
+            continue;
+        if ((para->pszUsageIdentifier && (chain->TrustStatus.dwErrorStatus & CERT_TRUST_IS_NOT_VALID_FOR_USAGE)) ||
+            !find_chain_issuer_match(chain, para, findFlags, &chain_index, &element_index) ||
+            (para->pfnFindCallback && !para->pfnFindCallback(cert, para->pvFindArg)))
+        {
+            CertFreeCertificateChain(chain);
+            continue;
+        }
+        if (para->cbSize >= sizeof(*para))
+        {
+            if (para->pdwIssuerChainIndex) *para->pdwIssuerChainIndex = chain_index;
+            if (para->pdwIssuerElementIndex) *para->pdwIssuerElementIndex = element_index;
+        }
+        CertFreeCertificateContext(cert);
+        return chain;
+    }
+    SetLastError(CRYPT_E_NOT_FOUND);
     return NULL;
 }
 
