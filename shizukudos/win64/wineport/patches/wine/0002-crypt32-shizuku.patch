+/* Shizuku: the key derivation below also hashes a random 32-byte machine secret, so a blob can only be decrypted
+ * on the machine that produced it. The secret is created on first use (by whichever process creates the registry key;
+ * others wait for its value) and kept in HKLM\\Software\\Shizuku\\Crypt32\\ProtectData, value MachineKey.
+ * It is NOT bound to a user or logon (Shizuku has one user and no credential store), and since the Shizuku registry is
+ * volatile, data protected before a reboot cannot be unprotected after it. */
+#define MACHINE_SECRET_LEN 32
+static BOOL get_machine_secret(BYTE *secret)
+{
+    static BYTE cached[MACHINE_SECRET_LEN];
+    static LONG have;
+    HKEY key;
+    DWORD disp, type, size, tries;
+    HCRYPTPROV prov;
+    BOOL ok = FALSE;
+
+    if (have)
+    {
+        memcpy(secret, cached, MACHINE_SECRET_LEN);
+        return TRUE;
+    }
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Shizuku\\Crypt32\\ProtectData", 0, NULL, 0, KEY_ALL_ACCESS,
+                        NULL, &key, &disp))
+        return FALSE;
+    if (disp == REG_CREATED_NEW_KEY)
+    {
+        if (CryptAcquireContextW(&prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT))
+        {
+            ok = CryptGenRandom(prov, MACHINE_SECRET_LEN, cached) &&
+                 !RegSetValueExW(key, L"MachineKey", 0, REG_BINARY, cached, MACHINE_SECRET_LEN);
+            CryptReleaseContext(prov, 0);
+        }
+    }
+    else
+    {
+        for (tries = 0; tries < 1000 && !ok; tries++)
+        {
+            size = MACHINE_SECRET_LEN;
+            ok = !RegQueryValueExW(key, L"MachineKey", NULL, &type, cached, &size) && type == REG_BINARY &&
+                 size == MACHINE_SECRET_LEN;
+            if (!ok) Sleep(1);
+        }
+    }
+    RegCloseKey(key);
+    if (!ok)
+    {
+        ERR("no machine secret available\n");
+        return FALSE;
+    }
+    have = 1;
+    memcpy(secret, cached, MACHINE_SECRET_LEN);
+    return TRUE;
+}
