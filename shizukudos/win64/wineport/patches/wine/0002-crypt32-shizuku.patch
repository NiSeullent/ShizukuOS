-BOOL WINAPI CryptProtectMemory(void *data, DWORD len, DWORD flags)
+/* Shizuku: CryptProtectMemory / CryptUnprotectMemory encrypt in place through RtlEncryptMemory / RtlDecryptMemory
+ * (cryptbase SystemFunction040/041), as on Windows. The length must be a multiple of CRYPTPROTECTMEMORY_BLOCK_SIZE; the
+ * CRYPTPROTECTMEMORY_* flags have the values of the RTL_ENCRYPT_OPTION_* flags they map to. */
+static BOOL protect_memory(void *data, DWORD len, DWORD flags, BOOL encrypt)
 {
-    static int fixme_once;
-    if (!fixme_once++) FIXME("(%p %lu %08lx): stub\n", data, len, flags);
+    NTSTATUS status;
+
+    TRACE("(%p %lu %08lx)\n", data, len, flags);
+    if (len % CRYPTPROTECTMEMORY_BLOCK_SIZE || flags > CRYPTPROTECTMEMORY_SAME_LOGON)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    status = encrypt ? RtlEncryptMemory(data, len, flags) : RtlDecryptMemory(data, len, flags);
+    if (status)
+    {
+        SetLastError(RtlNtStatusToDosError(status));
+        return FALSE;
+    }
     return TRUE;
 }
 
+BOOL WINAPI CryptProtectMemory(void *data, DWORD len, DWORD flags)
+{
+    return protect_memory(data, len, flags, TRUE);
+}
+
 BOOL WINAPI CryptUnprotectMemory(void *data, DWORD len, DWORD flags)
 {
-    static int fixme_once;
-    if (!fixme_once++) FIXME("(%p %lu %08lx): stub\n", data, len, flags);
-    return TRUE;
+    return protect_memory(data, len, flags, FALSE);
 }
