+/* Shizuku (wineport): Windows setup (and wineboot) runs DllRegisterServer of the cryptographic system DLLs, which
+ * registers their OID functions (wintrust: Authenticode encoders/decoders, SIPs, trust providers; cryptnet: revocation
+ * and URL retrieval). The Shizuku registry is volatile and has no setup step, so the first OID or SIP lookup of a
+ * process registers those DLLs that are present, once per boot (the PE file SIP key marks it). */
+void CRYPT_EnsureSystemRegistration(void)
+{
+    static LONG done;
+    static const WCHAR *const dlls[] = { L"wintrust.dll", L"cryptnet.dll" };
+    HRESULT (WINAPI *reg)(void);
+    HMODULE module;
+    HKEY key;
+    unsigned int i;
+
+    if (done || InterlockedCompareExchange(&done, 1, 0)) return;
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Cryptography\\OID\\EncodingType 0\\"
+                       L"CryptSIPDllGetSignedDataMsg\\{C689AAB8-8E78-11D0-8C47-00C04FC295EE}", 0, KEY_READ, &key))
+    {
+        RegCloseKey(key);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(dlls); i++)
+    {
+        if (!(module = LoadLibraryW(dlls[i]))) continue;
+        if ((reg = (void *)GetProcAddress(module, "DllRegisterServer")) && FAILED(reg()))
+            ERR("%s: DllRegisterServer failed\n", debugstr_w(dlls[i]));
+        FreeLibrary(module);
+    }
+}
