 }
 
+/* Shizuku (wineport): Windows setup registers the fonts it installs under ...\\CurrentVersion\\Fonts; the Shizuku
+ * registry is volatile and there is no setup step. So when that key does not exist yet, the first process that needs
+ * the system collection registers every font file found in %WINDIR%\\Fonts (value = file name relative to that
+ * directory, as Windows stores it), and maps the common Windows family names to the families shipped with the system
+ * (Noto) through Wine's own replacement table, HKCU\\Software\\Wine\\Fonts\\Replacements. */
+static void register_system_fonts(void)
+{
+    static const struct { const WCHAR *family, *replacement; } replacements[] =
+    {
+        { L"Arial", L"Noto Sans" }, { L"Segoe UI", L"Noto Sans" }, { L"Tahoma", L"Noto Sans" },
+        { L"Verdana", L"Noto Sans" }, { L"Microsoft Sans Serif", L"Noto Sans" }, { L"MS Shell Dlg", L"Noto Sans" },
+        { L"MS Shell Dlg 2", L"Noto Sans" }, { L"Calibri", L"Noto Sans" }, { L"Helvetica", L"Noto Sans" },
+        { L"Times New Roman", L"Noto Serif" }, { L"Georgia", L"Noto Serif" }, { L"Cambria", L"Noto Serif" },
+        { L"Times", L"Noto Serif" }, { L"Courier New", L"Noto Sans Mono" }, { L"Consolas", L"Noto Sans Mono" },
+        { L"Lucida Console", L"Noto Sans Mono" }, { L"Courier", L"Noto Sans Mono" },
+    };
+    WCHAR dir[MAX_PATH], pattern[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE find;
+    HKEY key;
+    DWORD disp;
+    unsigned int i;
+
+    if (!RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\Wine\\Fonts\\Replacements", 0, NULL, 0, KEY_ALL_ACCESS, NULL,
+                         &key, &disp))
+    {
+        if (disp == REG_CREATED_NEW_KEY)
+            for (i = 0; i < ARRAY_SIZE(replacements); ++i)
+                RegSetValueExW(key, replacements[i].family, 0, REG_SZ, (const BYTE *)replacements[i].replacement,
+                               (wcslen(replacements[i].replacement) + 1) * sizeof(WCHAR));
+        RegCloseKey(key);
+    }
+
+    if (RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts", 0, NULL, 0,
+                        KEY_ALL_ACCESS, NULL, &key, &disp))
+        return;
+    if (disp == REG_CREATED_NEW_KEY)
+    {
+        GetWindowsDirectoryW(dir, ARRAY_SIZE(dir));
+        wcscat(dir, L"\\fonts\\");
+        swprintf(pattern, ARRAY_SIZE(pattern), L"%s*", dir);
+        if ((find = FindFirstFileW(pattern, &fd)) != INVALID_HANDLE_VALUE)
+        {
+            do
+            {
+                const WCHAR *ext = wcsrchr(fd.cFileName, '.');
+                if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY || !ext) continue;
+                if (wcsicmp(ext, L".ttf") && wcsicmp(ext, L".otf") && wcsicmp(ext, L".ttc") && wcsicmp(ext, L".otc"))
+                    continue;
+                TRACE("registering %s\n", debugstr_w(fd.cFileName));
+                RegSetValueExW(key, fd.cFileName, 0, REG_SZ, (const BYTE *)fd.cFileName,
+                               (wcslen(fd.cFileName) + 1) * sizeof(WCHAR));
+            } while (FindNextFileW(find, &fd));
+            FindClose(find);
+        }
+    }
+    RegCloseKey(key);
+}
+
 static HKEY open_fonts_key(void)
 {
     HKEY hkey = NULL;
 
+    register_system_fonts();
+
     RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts",
             0, GENERIC_READ | KEY_QUERY_VALUE, &hkey);
 
