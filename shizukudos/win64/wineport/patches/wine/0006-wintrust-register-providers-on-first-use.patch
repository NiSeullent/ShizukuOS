+/* Shizuku (wineport): the provider keys Windows setup creates are registered on first use (volatile registry, no
+ * setup step): when the software publisher provider is not registered, wintrust runs its own DllRegisterServer. */
+HRESULT WINAPI DllRegisterServer(void);
+
+static void WINTRUST_EnsureRegistered(void)
+{
+    static LONG done;
+    HKEY key;
+
+    if (done || InterlockedCompareExchange( &done, 1, 0 )) return;
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE,
+                        L"Software\\Microsoft\\Cryptography\\Providers\\Trust\\Initialization\\{00AAC56B-CD44-11D0-8CC2-00C04FC295EE}",
+                        0, KEY_READ, &key ))
+    {
+        RegCloseKey( key );
+        return;
+    }
+    if (FAILED(DllRegisterServer())) ERR("DllRegisterServer failed\n");
+}
