 }
 
 
+/* Shizuku: the CSP registry keys that Windows setup (and wineboot) create are made on first use instead, because the
+ * Shizuku registry is volatile and there is no setup step: when no provider type is registered, rsaenh.dll registers
+ * its providers through its own DllRegisterServer (the same .rgs script Wine uses). */
+static void CRYPT_EnsureDefaultProviders(void)
+{
+	static LONG done;
+	HKEY key;
+	HMODULE rsaenh;
+	HRESULT (WINAPI *reg)(void);
+
+	if (done) return;
+	if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Cryptography\\Defaults\\Provider Types\\Type 001",
+			   0, KEY_READ, &key))
+	{
+		RegCloseKey(key);
+		done = 1;
+		return;
+	}
+	if ((rsaenh = LoadLibraryW(L"rsaenh.dll")))
+	{
+		if ((reg = (void *)GetProcAddress(rsaenh, "DllRegisterServer")) && FAILED(reg()))
+			ERR("rsaenh registration failed\n");
+		FreeLibrary(rsaenh);
+	}
+	else ERR("rsaenh.dll not found, no cryptographic service provider is registered\n");
+	done = 1;
+}
+
