if (ENABLE_XSLT)
    find_package(LibXslt 1.1.32 REQUIRED)
endif ()
if (USE_WOFF2)
    find_package(WOFF2 1.0.2 COMPONENTS dec)
    if (NOT WOFF2_FOUND)
        message(FATAL_ERROR "libwoff2dec is required for USE_WOFF2")
    endif ()
    find_package(Brotli REQUIRED COMPONENTS dec)
endif ()

# Everything static: one image per program (W1's toolchain links statically).
set(bmalloc_LIBRARY_TYPE STATIC)
set(WTF_LIBRARY_TYPE STATIC)
set(JavaScriptCore_LIBRARY_TYPE STATIC)
set(PAL_LIBRARY_TYPE STATIC)
set(WebCore_LIBRARY_TYPE STATIC)
set(WebCoreTestSupport_LIBRARY_TYPE STATIC)

set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")

# No GPU: the Khronos EGL/GLES headers from WebKit's ANGLE directory (headers only, ANGLE is not built) and a stub EGL
# (port/egl/shzegl.c) whose display query fails, so WebCore and Skia never get a GL context and use the unaccelerated
# Skia raster paths. Skia's CMake links ${EGL_LIBRARIES}.
include_directories(SYSTEM "${CMAKE_SOURCE_DIR}/Source/ThirdParty/ANGLE/include")
add_library(ShizukuEGL STATIC "${SHIZUKU_PORT_DIR}/egl/shzegl.c")
set(EGL_LIBRARIES ShizukuEGL)
add_library(OpenGL::GLES ALIAS ShizukuEGL)
add_library(EGL::EGL ALIAS ShizukuEGL)
