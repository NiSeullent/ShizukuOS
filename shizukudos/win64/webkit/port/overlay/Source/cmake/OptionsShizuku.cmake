# ShizukuDOS "Shizuku" port (agent W3; docs/shizukudos10/WEBKIT.md "WebCore and the Shizuku port").
# Copied into the pinned WebKit tree by shizukudos/win64/webkit/port/build_port.py (overlay, not an upstream file).
#
# A single-process WebCore port for the Kernel64 Win64 runtime: JavaScriptCore/bmalloc as agent W1's JSCOnly-on-Windows
# build (C loop, static), WTF as the Windows port (Win32 message-pump RunLoop), WebCore with Skia's CPU raster backend,
# HarfBuzz + ICU text, FreeType fonts from the system font directory, curl + OpenSSL networking, libxml2/libxslt,
# SQLite and the image decoders. No WebKit2 (no multi-process, no IPC), no WebKitLegacy, no GPU (the Shizuku runtime
# has no OpenGL/Direct3D: EGL is a stub that reports no display, so WebCore stays on its unaccelerated paths), no
# media, no WebGL/WebGPU/WebRTC.
# The embedding layer (ShizukuWebView, T_WK_RENDER.EXE, ...) lives in shizukudos/win64/webkit/port and is added as a
# subdirectory through SHIZUKU_PORT_DIR.

find_package(Threads REQUIRED)

set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)

add_definitions(-DBUILDING_SHIZUKU__)

set(PROJECT_VERSION_MAJOR 1)
set(PROJECT_VERSION_MINOR 0)
set(PROJECT_VERSION_MICRO 0)
set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})

# The Windows environment of OptionsJSCOnly.cmake (what W1's jsc.exe is built with).
add_definitions(-D_WINDOWS -DNTDDI_VERSION=0x0A000006 -D_WIN32_WINNT=0x0A00)
add_definitions(-DNOMINMAX)
add_definitions(-DUNICODE -D_UNICODE)
add_definitions(-DNOCRYPT)
add_definitions(-D_CRT_NONSTDC_NO_DEPRECATE)
add_definitions(-D_WINSOCKAPI_=)

find_package(CURL 7.87.0 REQUIRED)
find_package(HarfBuzz 1.4.2 REQUIRED COMPONENTS ICU)
find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
find_package(JPEG 1.5.2 REQUIRED)
find_package(LibXml2 2.9.7 REQUIRED)
find_package(OpenSSL REQUIRED)
find_package(PNG 1.6.34 REQUIRED)
find_package(SQLite3 3.23.1 REQUIRED)
find_package(ZLIB 1.2.11 REQUIRED)
find_package(LibPSL 0.20.2 REQUIRED)
