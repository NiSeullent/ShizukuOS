/* SPDX-License-Identifier: GPL-2.0-only
 * Version resource of kernel32.dll. The numeric version is the OS profile the PEB declares (10.0.22631, see kernel64/ldr.c):
 * programs read a system DLL's file version to learn the Windows build they run on (Chromium base::win::OSInfo::
 * Kernel32Version, crashpad's module list), so it must agree with RtlGetVersion. The strings say what this really is. */
1 VERSIONINFO
 FILEVERSION 10,0,22631,1
 PRODUCTVERSION 10,0,22631,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The Shizuku Authors"
            VALUE "FileDescription", "Shizuku Win64 kernel32 - Windows API client DLL over Kernel64"
            VALUE "FileVersion", "10.0.22631.1 (ShizukuDOS Win64 runtime)"
            VALUE "InternalName", "kernel32"
            VALUE "OriginalFilename", "kernel32.dll"
            VALUE "ProductName", "ShizukuDOS 10 Win64 subsystem"
            VALUE "ProductVersion", "10.0.22631.1"
            VALUE "LegalCopyright", "GPL-2.0-only"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
